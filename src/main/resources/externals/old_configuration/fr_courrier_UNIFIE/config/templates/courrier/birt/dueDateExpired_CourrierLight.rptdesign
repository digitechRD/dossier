                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">DOC_ID</property>
                    <property name="nativeName">DOC_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">C_OBJET</property>
                    <property name="nativeName">C_OBJET</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">N_CHRONO</property>
                    <property name="nativeName">N_CHRONO</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">D_ECHEANCE</property>
                    <property name="nativeName">D_ECHEANCE</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">USR_FIRSTNAME</property>
                    <property name="nativeName">USR_FIRSTNAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">USR_NAME</property>
                    <property name="nativeName">USR_NAME</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">ORG_LABEL</property>
                    <property name="nativeName">ORG_LABEL</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">ORG_ID</property>
                    <property name="nativeName">ORG_ID</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select doc.doc_id, doc.c_objet, doc.n_chrono, doc.d_echeance, fieldU.usr_firstname, fieldU.usr_name, fieldO.org_label, fieldO.org_id
from doc_cou_courrier_in doc, (select organization.org_id from organization start with org_id = ? connect by prior org_id = org_father_id ) orgList,
    (select docr.doc_id from authority_item al, docref_cou_courrier_in docr where docr.aui_id = al.aui_id and (al.aui_code = 'REPONDU' or al.aui_code = 'DIFFUSE')) itemsAL,
    (select doc_id, orga.* from airsfield, docref_cou_courrier_in docr, organization orga
      where airsfield.fld_code = 'O_PROPRIETAIRE' and airsfield.fld_id = docr.fld_id and orga.org_id = docr.org_id ) fieldO,
    (select doc_id, users.* from airsfield, docref_cou_courrier_in docr, users
      where airsfield.fld_code = 'U_PROPRIETAIRE' and airsfield.fld_id = docr.fld_id and users.usr_id = docr.usr_id ) fieldU
where doc.d_echeance < SYSDATE
  and fieldO.org_id = orgList.org_id
  and doc.doc_id = itemsAL.doc_id
  and doc.doc_id = fieldU.doc_id (+)
  and doc.doc_id = fieldO.doc_id (+)
order by doc_id]]></xml-property>
        </oda-data-set>
