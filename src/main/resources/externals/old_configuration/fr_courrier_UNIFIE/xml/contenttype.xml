                  (T_ETAT_COURRIER.ITEM="128" ET (U_COPIES.USR="#LOGIN_ID#" OU O_COPIES.ORG="#ORG_ID#"))
                </ns2:airsvalue>
                <ns2:airsProfile>10</ns2:airsProfile>
                <ns2:airsProfileCode>DOS_AGENT</ns2:airsProfileCode>
            </ns2:dossierrequest>
            <ns2:dossierrequest name="gestionnaire">
                <ns2:contentType>COU_COURRIER_IN</ns2:contentType>
                <ns2:airsvalue>
                  (T_ETAT_COURRIER.ITEM="122") OU
                  (T_ETAT_COURRIER.ITEM="123" ET U_VALIDEURS.USR="#LOGIN_ID#") OU
                  (T_ETAT_COURRIER.ITEM="125" ET U_CREAT.USR="#LOGIN_ID#") OU
                  (T_ETAT_COURRIER.ITEM="126" ET ((O_PROPRIETAIRE.ORG="#ORG_ID#") OU U_PROPRIETAIRE.USR="#LOGIN_ID#" OU U_COPIES.USR="#LOGIN_ID#" OU O_COPIES.ORG="#ORG_ID#")) OU
                  (T_ETAT_COURRIER.ITEM="127" ET ((O_PROPRIETAIRE.ORG="#ORG_ID#") OU U_PROPRIETAIRE.USR="#LOGIN_ID#" OU U_COPIES.USR="#LOGIN_ID#" OU O_COPIES.ORG="#ORG_ID#" OU U_VISEURS.USR="#LOGIN_ID#")) OU
                  (T_ETAT_COURRIER.ITEM="128" ET ((O_PROPRIETAIRE.ORG="#ORG_ID#") OU U_PROPRIETAIRE.USR="#LOGIN_ID#")) OU
                 (T_ETAT_COURRIER.ITEM="128" ET (U_COPIES.USR="#LOGIN_ID#" OU O_COPIES.ORG="#ORG_ID#"))
               </ns2:airsvalue>
                <ns2:airsProfile>11</ns2:airsProfile>
                <ns2:airsProfileCode>DOS_GESTIONNAIRE</ns2:airsProfileCode>
            </ns2:dossierrequest>
            <ns2:dossierrequest name="direction">
                <ns2:contentType>COU_COURRIER_IN</ns2:contentType>
                <ns2:airsvalue>
                  (T_ETAT_COURRIER.ITEM="122") OU
                  (T_ETAT_COURRIER.ITEM="123" ET U_VALIDEURS.USR="#LOGIN_ID#") OU
                  (T_ETAT_COURRIER.ITEM="125" ET U_CREAT.USR="#LOGIN_ID#") OU
                  (T_ETAT_COURRIER.ITEM="126" ET (O_PROPRIETAIRE.ROOTORG="#ORG_ID#" OU U_COPIES.USR="#LOGIN_ID#" OU O_COPIES.ORG="#ORG_ID#")) OU
                  (T_ETAT_COURRIER.ITEM="127" ET (O_PROPRIETAIRE.ROOTORG="#ORG_ID#" OU U_COPIES.USR="#LOGIN_ID#" OU O_COPIES.ORG="#ORG_ID#" OU U_VISEURS.USR="#LOGIN_ID#")) OU
                  (T_ETAT_COURRIER.ITEM="128" ET O_PROPRIETAIRE.ROOTORG="#ORG_ID#") OU 
                  (T_ETAT_COURRIER.ITEM="128" ET (U_COPIES.USR="#LOGIN_ID#" OU O_COPIES.ORG="#ORG_ID#"))
               </ns2:airsvalue>
                <ns2:airsProfile>12</ns2:airsProfile>
                <ns2:airsProfileCode>DOS_DIRECTION</ns2:airsProfileCode>
            </ns2:dossierrequest>
        </extraFilter>
