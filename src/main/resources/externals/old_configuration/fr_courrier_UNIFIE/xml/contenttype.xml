                  (T_ETAT_COURRIER.ITEM="127" ET ((O_PROPRIETAIRE.ORG="#ORG_ID#" ET U_PROPRIETAIRE IS NULL) OU U_PROPRIETAIRE.USR="#LOGIN_ID#" OU U_COPIES.USR="#LOGIN_ID#" OU O_COPIES.ORG="#ORG_ID#" OU U_VISEURS.USR="#LOGIN_ID#")) OU
