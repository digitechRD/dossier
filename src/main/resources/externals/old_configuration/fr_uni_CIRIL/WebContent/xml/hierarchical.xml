<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ns2:hierarchique xmlns="http://www.digitech.com/dossiers/common" xmlns:ns2="http://www.digitech.com/dossiers/hierarchical" customerName="CIRIL" version="6.0.0">
    <ns2:organization id="0" name="DEFAULT">
	<!-- COURRIER EXPRESS DEBUT -->
      <ns2:contentType icon="" name="COU_COURRIER_IN" visible="false">
            <ns2:libelle dateFormat="dd/MM/yyyy">{N_CHRONO} - {C_OBJET}</ns2:libelle>
            <ns2:field_hier>D_ENVOI</ns2:field_hier>
            <ns2:sorting>
                <sortingPolicy>
                    <direction>ASCENDING</direction>
                    <codeField>D_ENVOI</codeField>
                </sortingPolicy>
            </ns2:sorting>
            <ns2:filter></ns2:filter>
        </ns2:contentType>
        <ns2:contentType icon="" name="COU_COURRIER_OUT" visible="false">
            <ns2:libelle dateFormat="dd/MM/yyyy">{N_CHRONO} - {C_OBJET}</ns2:libelle>
            <ns2:field_hier>D_ENVOI</ns2:field_hier>
            <ns2:sorting>
                <sortingPolicy>
                    <direction>ASCENDING</direction>
                    <codeField>D_ENVOI</codeField>
                </sortingPolicy>
            </ns2:sorting>
            <ns2:filter></ns2:filter>
        </ns2:contentType>
		<!-- COURRIER EXPRESS FIN -->
		<!-- GF DEBUT -->
		 <ns2:contentType name="GF_MARCHE" visible="true">
            <ns2:libelle>{GF_MA_NUMMAR}</ns2:libelle>
        </ns2:contentType>
        <ns2:contentType name="GF_TIERS" visible="true">
            <ns2:libelle>{GF_TI_NUMTIE} {GF_TI_NOMTIE}</ns2:libelle>
            <ns2:field_hier>GF_TI_NUMTIE</ns2:field_hier>
        </ns2:contentType>
        <ns2:contentType name="GF_MOUVEMENT" visible="true">
            <ns2:libelle>{GF_MV_ID} {GF_MV_LIBMVT}</ns2:libelle>
            <ns2:field_hier>GF_MV_LIEN</ns2:field_hier>
            <ns2:field_hier>GF_MV_IDLIEN</ns2:field_hier>
        </ns2:contentType>
        <ns2:contentType name="GF_PES" visible="true">
            <ns2:libelle>{GF_PES_NOMFIC}</ns2:libelle>
            <ns2:field_hier>GF_PES_BUD</ns2:field_hier>
            <ns2:field_hier>GF_PES_TYPE</ns2:field_hier>
        </ns2:contentType>
        <ns2:contentType name="GF_PES_EXE" visible="true">
            <ns2:libelle>Exercice : {GF_PES_EXE}</ns2:libelle>
        </ns2:contentType>
		<!-- GF FIN -->
		<!-- RH DEBUT -->
		 <ns2:contentType name="RH_AGENT" visible="true">
            <ns2:libelle>{RH_TITRE} {RH_PRENOM} {RH_NOMUSA} {RH_MATRICULE}</ns2:libelle>
            <ns2:sorting/>
        </ns2:contentType>
         <ns2:contentType name="RH_DOCUMENT_EXTERNE" visible="true">
            <ns2:libelle>{RH_NOMDOC}</ns2:libelle>
            <ns2:field_hier>RH_CATEGORIE</ns2:field_hier>
            <ns2:field_hier>RH_SOUS_CATEGORIE</ns2:field_hier>
            <ns2:sorting>
                <sortingPolicy>
                    <direction>ASCENDING</direction>
                    <codeField>RH_CATEGORIE</codeField>
                </sortingPolicy>
                <sortingPolicy>
                    <direction>ASCENDING</direction>
                    <codeField>RH_SOUS_CATEGORIE</codeField>
                </sortingPolicy>
                <sortingPolicy>
                    <direction>DICREASING</direction>
                    <codeField>RH_DATDEB</codeField>
                </sortingPolicy>
                <sortingPolicy>
                    <direction>ASCENDING</direction>
                    <codeField>RH_NOMDOC</codeField>
                </sortingPolicy>
            </ns2:sorting>
        </ns2:contentType>
		<!-- RH FIN -->
		<!-- URBANISME DEBUT -->
		<ns2:contentType name="DOC_PLU" visible="true">
             <ns2:libelle>{PLU_LBLDOC}</ns2:libelle>
             <ns2:field_hier>PLU_ETAPE</ns2:field_hier>
            <ns2:sorting/>
            <ns2:filterField>
                <ns2:operator>=</ns2:operator>
                 <ns2:label>Etape</ns2:label>
                 <ns2:airsField>PLU_LBLDOC</ns2:airsField>
            </ns2:filterField>
        </ns2:contentType>
        <ns2:contentType name="DOS_PLU" visible="true">
             <ns2:libelle>Dossier PLU n° {PLU_CODERGT}</ns2:libelle>
            <ns2:sorting/>
        </ns2:contentType>
        <ns2:contentType name="DOC_PAR" visible="true">
             <ns2:libelle>{PAR_LBLDOC}</ns2:libelle>
             <ns2:field_hier>PAR_ETAPE</ns2:field_hier>
            <ns2:sorting/>
            <ns2:filterField>
                <ns2:operator>=</ns2:operator>
                 <ns2:label>Etape</ns2:label>
                 <ns2:airsField>PAR_ETAPE</ns2:airsField>
                <type>list</type>
            </ns2:filterField>
        </ns2:contentType>
        <ns2:contentType name="DOS_PAR" visible="true">
             <ns2:libelle>Parcelle n° {PAR_CODEPCL}</ns2:libelle>
            <ns2:sorting/>
        </ns2:contentType>
        <ns2:contentType name="DOC_AOS" visible="true">
             <ns2:libelle>{AOS_LBLDOC}</ns2:libelle>
             <ns2:field_hier>AOS_ETAPE</ns2:field_hier>
            <ns2:sorting/>
            <ns2:filterField>
                <ns2:operator>= </ns2:operator>
                 <ns2:label>Etape </ns2:label>
                 <ns2:airsField>AOS_ETAPE</ns2:airsField>
            </ns2:filterField>
        </ns2:contentType>
        <ns2:contentType name="DOS_AOS" visible="true">
             <ns2:libelle>Dossier n° {AOS_NUMDOS}</ns2:libelle>
            <ns2:sorting/>
        </ns2:contentType>
        <ns2:contentType name="DOS_FON" visible="true">
             <ns2:libelle>{FON_NUMDOS}</ns2:libelle>
            <ns2:sorting/>
        </ns2:contentType>
        <ns2:contentType name="DOC_FON" visible="true">
             <ns2:libelle>{FON_LBLDOC} </ns2:libelle>
             <ns2:field_hier>FON_ETAPE</ns2:field_hier>
            <ns2:sorting/>
            <ns2:filterField>
                <ns2:operator>= </ns2:operator>
                 <ns2:label>Etape </ns2:label>
                 <ns2:airsField>FON_ETAPE</ns2:airsField>
            </ns2:filterField>
        </ns2:contentType>
		<!-- URBANISME FIN -->
    </ns2:organization>
</ns2:hierarchique>
