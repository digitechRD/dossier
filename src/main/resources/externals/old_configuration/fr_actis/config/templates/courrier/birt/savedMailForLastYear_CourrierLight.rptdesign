            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">TO_CHAR(D_CREAT,'YYYY-MM')</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">Number of mails</property>
                        <property name="dataType">decimal</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">Data Source</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">TO_CHAR(D_CREAT,'YYYY-MM')</property>
                    <property name="nativeName">TO_CHAR(D_CREAT,'YYYY-MM')</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">Number of mails</property>
                    <property name="nativeName">Number of mails</property>
                    <property name="dataType">decimal</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select to_char(D_CREAT,'YYYY-MM'), count(distinct doc_cou_courrier_in.DOC_ID) "Number of mails" from doc_cou_courrier_in, docref_cou_courrier_in, (select organization.org_id from organization start with org_id = ? connect by prior org_id = org_father_id ) orgList
where D_CREAT > ADD_MONTHS(SYSDATE,-12) 
  and doc_cou_courrier_in.DOC_ID = docref_cou_courrier_in.doc_id 
  and docref_cou_courrier_in.org_id = orgList.org_id
group by to_char(D_CREAT,'YYYY-MM')
order by to_char(D_CREAT,'YYYY-MM')]]></xml-property>
