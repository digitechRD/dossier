        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="createdMailByMonth" id="16">
            <list-property name="parameters">
                <structure>
                    <property name="name">organization</property>
                    <property name="paramName">organization</property>
                    <property name="dataType">integer</property>
