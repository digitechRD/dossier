    <data-sets>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Consultation" id="123">
            <property name="dataSource">AIRS3DOSSIERS</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">Date début</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">java.text.DateFormat.getDateInstance(java.text.DateFormat.SHORT, java.util.Locale.FRANCE).parse("01/01/2005")</expression>
                    <property name="isInput">true</property>
                </structure>
                <structure>
                    <property name="name">Date fin</property>
                    <property name="position">2</property>
                    <expression name="defaultValue">new java.util.Date()</expression>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
                <structure>
                    <property name="name">Organisation</property>
                    <property name="dataType">string</property>
                    <property name="position">3</property>
                    <expression name="defaultValue">"%"</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select trunc(EVT_DATE,'DD'),count(*) 
from evt_airs 
where TEVT_ID=32
and EVT_DATE between ? and ?
and usr_id in (
select usr_id from user_orga where org_id in(
select org_id from organization where ORG_LABEL LIKE ?
))
group by trunc(EVT_DATE,'DD')</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Organisations" id="124">
            <property name="dataSource">AIRS3DOSSIERS</property>
            <property name="queryText">select ORG_LABEL
from organization</property>
        </oda-data-set>
    </data-sets>
