    <data-sets>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="receptions" id="5">
            <list-property name="columnHints">
                <structure>
                    <property name="columnName">DATERECEP</property>
                    <property name="displayName">Date</property>
                </structure>
                <structure>
                    <property name="columnName">MAX(COURRIERSNUM)</property>
                    <property name="displayName">Courriers</property>
                </structure>
                <structure>
                    <property name="columnName">MAX(TRANSFERTSPPEBO)</property>
                    <property name="displayName">Transferts PPEBO</property>
                </structure>
                <structure>
                    <property name="columnName">TOTAL</property>
                    <property name="displayName">Total</property>
                </structure>
            </list-property>
            <property name="dataSource">AIRS_MEDIADOC</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">Date de début</property>
                    <property name="dataType">dateTime</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">java.text.DateFormat.getDateInstance(java.text.DateFormat.SHORT, java.util.Locale.FRANCE).parse("01/01/2005")</expression>
                    <property name="isInput">true</property>
                </structure>
                <structure>
                    <property name="name">Date de fin</property>
                    <property name="dataType">dateTime</property>
                    <property name="position">2</property>
                    <expression name="defaultValue">new java.util.Date()</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select DATERECEP, max(COURRIERSNUM), max(TRANSFERTSPPEBO), max(COURRIERSNUM)+ max(TRANSFERTSPPEBO)total
FROM
(
select trunc(D_CREAT,'DD') DATERECEP, count(*) COURRIERSNUM, 0 TRANSFERTSPPEBO from doc_docsal where doc_id in (  
select doc_id from docref_docsal where aui_id = 31
) 
group by trunc(D_CREAT,'DD') 

UNION
 
select TRUNC(EvtDate,'DD') DATERECEP ,0 COURRIERSNUM, count(*) TRANSFERTSPPEBO from   
(   
SELECT    
      EVT.EVT_ID as EvtID,    
      EVT.GEVT_ID as GevtId,    
      EVT.TEVT_ID as TevId,    
      EVT.EVT_DATE As EvtDate,    
      EVT.EVT_NB,    
      EVT.USR_ID as UsrId,    
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,    
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,    
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache,    
      DS.CTY_ID    
   FROM    
      EVT_ACTIONDOC DOC,    
      EVT_AIRS      EVT,    
      DOC_DOCSAL    DS     
   WHERE    
      EVT.EVT_ID = DOC.EVT_ID    
      AND    
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow')    
      AND    
      DS.DOC_ID = DOC.DOC_ID    
         
) where taskname='AutreRejetATraiter' and sortietache='a qualifier' 
group by trunc(EvtDate,'DD') 

)
where DATERECEP BETWEEN ? AND ?
group by DATERECEP
</property>
        </oda-data-set>
    </data-sets>
