    <data-sets>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="stocks" id="123">
            <property name="dataSource">AIRS_MEDIADOC</property>
            <list-property name="parameters">
                <structure>
                    <property name="name">Date début1</property>
                    <property name="dataType">dateTime</property>
                    <property name="position">1</property>
                    <expression name="defaultValue">java.text.DateFormat.getDateInstance(java.text.DateFormat.SHORT, java.util.Locale.FRANCE).parse("01/01/2005")</expression>
                    <property name="isInput">true</property>
                </structure>
                <structure>
                    <property name="name">Date fin1</property>
                    <property name="dataType">dateTime</property>
                    <property name="position">2</property>
                    <expression name="defaultValue">new java.util.Date()</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">SELECT
   TO_DATE(TO_CHAR(TSK_DATE, 'DD/MM/YY'), 'DD/MM/YY') as "DATE_ARRIVEE",
   SUM(DECODE(QUALIF, NULL  , 1, 0)) as "NONQUALIF",
   SUM(DECODE(QUALIF, 'NR'  , 1, 0)) as "RECLAMATION",
   SUM(DECODE(QUALIF, 'REF' , 1, 0)) as "REFUS"      ,
   SUM(DECODE(QUALIF, 'RECH', 1, 0)) as "RECHERCHE"  ,
   SUM(DECODE(QUALIF, 'DINF', 1, 0)) as "INFORMATION",
   count(*) as "TOTALC"
FROM
   WKF_ACTIVE_TASKS
WHERE
   TSK_NAME IN
   (
      'indexationIAS'                   ,
      'indexationApresEnrichissementIAS',
      'CourrierAQualifier'              ,
      'CourrierARepondre'               ,
      'CourrierATraiter'                ,
      'CourrierEnAttente'               ,
      'AutreRejetAQualifer'             , 
      'AutreRejetCourrierEnAttente'     , 
      'AutreRejetIASAQualifier'         ,
      'AutreRejetIASEnAttente'          ,
      'AutreRejetIASATraiter'           ,
      'RejetLTIASAQualifier'            ,
      'RejetLTIASATraiter'              ,
      'RejetLTIASEnAttente'
   )
   AND
   TSK_DATE BETWEEN ? AND ?
GROUP BY
   TO_DATE(TO_CHAR(TSK_DATE, 'DD/MM/YY'), 'DD/MM/YY')
</property>
        </oda-data-set>
    </data-sets>
