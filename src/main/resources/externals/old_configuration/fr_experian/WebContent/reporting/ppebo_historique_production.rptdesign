            <property name="queryText">select DATE_ACTION,max(INDEXES),max(COURRIERS),max(TRAITES),max(VERIFIES),max(CLOTURES) from(
select trunc(EvtDate,'DD') DATE_ACTION, count(*) INDEXES,0 COURRIERS,0 TRAITES,0 VERIFIES,0 CLOTURES from     
(     
SELECT      
      EVT.EVT_ID as EvtID,      
      EVT.GEVT_ID as GevtId,      
      EVT.TEVT_ID as TevId,      
      EVT.EVT_DATE As EvtDate,      
      EVT.EVT_NB,      
      EVT.USR_ID as UsrId,      
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,      
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,      
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache      
 
           
   FROM      
      EVT_ACTIONDOC DOC,      
      EVT_AIRS      EVT,
      USERS USR,USER_ORGA UGO             
   WHERE      
      EVT.EVT_ID = DOC.EVT_ID      
      AND      
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow')
      AND 
      EVT.USR_ID =UGO.USR_ID 
      AND 
      UGO.ORG_ID=2 
      AND 
      USR.USR_ID=EVT.USR_ID
      AND 
      EVT.EVT_DATE BETWEEN ? AND ? 
      AND 
      USR_LOGIN like ?      
             
           
) 
WHERE taskname='indexationPPEBO' 
OR
taskname='indexationApresEnrichissement'
 
group by trunc(EvtDate,'DD')


UNION

select trunc(EvtDate,'DD') DATE_ACTION, 0 INDEXES,count(*) COURRIERS,0 TRAITES,0 VERIFIES,0 CLOTURES from    
(     
SELECT      
      EVT.EVT_ID as EvtID,      
      EVT.GEVT_ID as GevtId,      
      EVT.TEVT_ID as TevId,      
      EVT.EVT_DATE As EvtDate,      
      EVT.EVT_NB,      
      EVT.USR_ID as UsrId,      
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,      
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,      
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache      
     
   FROM      
      EVT_ACTIONDOC DOC,      
      EVT_AIRS      EVT,      
      USERS USR,USER_ORGA UGO        
   WHERE      
      EVT.EVT_ID = DOC.EVT_ID      
      AND      
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow') 
      AND 
      EVT.USR_ID =UGO.USR_ID 
      AND 
      UGO.ORG_ID=2 
      AND 
      USR.USR_ID=EVT.USR_ID
      AND 
      EVT.EVT_DATE BETWEEN ? AND ? 
      AND 
      USR_LOGIN like ?     
   
           
)
where (taskname='CourrierAutreRejetATraiter') 


group by trunc(EvtDate,'DD')

UNION

select trunc(EvtDate,'DD') DATE_ACTION, 0 INDEXES,0 COURRIERS,count(*) TRAITES,0 VERIFIES,0 CLOTURES from     
(     
SELECT      
      EVT.EVT_ID as EvtID,      
      EVT.GEVT_ID as GevtId,      
      EVT.TEVT_ID as TevId,      
      EVT.EVT_DATE As EvtDate,      
      EVT.EVT_NB,      
      EVT.USR_ID as UsrId,      
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,      
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,      
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache      

   FROM      
      EVT_ACTIONDOC DOC,      
      EVT_AIRS      EVT,
      USERS USR,USER_ORGA UGO       
   WHERE      
      EVT.EVT_ID = DOC.EVT_ID      
      AND      
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow')  
      AND 
      EVT.USR_ID =UGO.USR_ID 
      AND 
      UGO.ORG_ID=2 
      AND 
      USR.USR_ID=EVT.USR_ID
      AND 
      EVT.EVT_DATE BETWEEN ? AND ? 
      AND 
      USR_LOGIN like ?    
          
           
)
where (taskname='RejetLtATraiter' and (sortietache='a rapprocher' or sortietache='a saisir')) 
OR 
  (taskname='AutreRejetATraiter' and (sortietache='a clore' or sortietache='a saisir' or sortietache='a qualifier'))
 
   
group by trunc(EvtDate,'DD')

UNION

select trunc(EvtDate,'DD') DATE_ACTION, 0 INDEXES,0 COURRIERS,0 TRAITES,count(*) VERIFIES,0 CLOTURES from       
(      
SELECT       
      EVT.EVT_ID as EvtID,       
      EVT.GEVT_ID as GevtId,       
      EVT.TEVT_ID as TevId,       
      EVT.EVT_DATE As EvtDate,       
      EVT.EVT_NB,       
      EVT.USR_ID as UsrId,       
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache
   FROM       
      EVT_ACTIONDOC DOC,       
      EVT_AIRS      EVT,
      USERS USR,USER_ORGA UGO        
   WHERE       
      EVT.EVT_ID = DOC.EVT_ID       
      AND       
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow') 
      AND 
      EVT.USR_ID =UGO.USR_ID 
      AND 
      UGO.ORG_ID=2 
      AND 
      USR.USR_ID=EVT.USR_ID
      AND 
      EVT.EVT_DATE BETWEEN ? AND ? 
      AND 
      USR_LOGIN like ?      

            
) 
 where (taskname='TraitementAVerifier')  
  
    
group by trunc(EvtDate,'DD')

UNION

select trunc(EvtDate,'DD') DATE_ACTION, 0 INDEXES,0 COURRIERS,0 TRAITES,0 VERIFIES,count(*) CLOTURES from       
(      
SELECT       
      EVT.EVT_ID as EvtID,       
      EVT.GEVT_ID as GevtId,       
      EVT.TEVT_ID as TevId,       
      EVT.EVT_DATE As EvtDate,       
      EVT.EVT_NB,       
      EVT.USR_ID as UsrId,       
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                    ) as sortieTache       

   FROM       
      EVT_ACTIONDOC DOC,       
      EVT_AIRS      EVT,
      USERS USR,USER_ORGA UGO        
   WHERE       
      EVT.EVT_ID = DOC.EVT_ID       
      AND       
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow') 
      AND 
      EVT.USR_ID =UGO.USR_ID 
      AND 
      UGO.ORG_ID=2 
      AND 
      USR.USR_ID=EVT.USR_ID
      AND 
      EVT.EVT_DATE BETWEEN ? AND ? 
      AND 
      USR_LOGIN like ?  
            
) 
 where (taskname='AutreRejetATraiter' and (sortietache='a clore'))
 OR
 (taskname='CourrierAutreRejetATraiter' and (sortietache='a clore'))  
  
    
group by trunc(EvtDate,'DD')

)
group by DATE_ACTION</property>
