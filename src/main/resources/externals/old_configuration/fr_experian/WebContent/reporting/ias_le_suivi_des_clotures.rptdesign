                    <expression name="defaultValue">new java.util.Date()</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select DATE_CLOTURE,max(INFORMATION),max(RECLAMATION),max(REFUS),max(RECHERCHE),max(INFORMATION)+max(RECLAMATION)+max(REFUS)+max(RECHERCHE) TOTAL from(
select count(*) INFORMATION, 0 RECLAMATION, 0 REFUS, 0 RECHERCHE,trunc(LASTDATE,'DD') DATE_CLOTURE from 
( 
SELECT max(EvtDate) LASTDATE,doc_id from ( 
SELECT          
      EVT.EVT_ID as EvtID,          
      EVT.GEVT_ID as GevtId,          
      EVT.TEVT_ID as TevId,          
      EVT.EVT_DATE As EvtDate,          
      EVT.EVT_NB,          
      EVT.USR_ID as UsrId,    
      DOC.DOC_ID as DOC_ID,         
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,          
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,          
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache          
  
   FROM          
      EVT_ACTIONDOC DOC,          
      EVT_AIRS      EVT          
        
   WHERE          
      EVT.EVT_ID = DOC.EVT_ID          
      AND          
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow')          
      AND     
      EVT.EVT_DATE BETWEEN ? AND ? 
      ) 
group by doc_id 
) CLOS, 
docref_docsal DREF 
where DREF.doc_id=CLOS.doc_id and fld_id=33 and DREF.aui_id=170 and DREF.doc_id in (  
select doc_id from docref_docsal where fld_id=27 and aui_id=101  
) group by trunc(LASTDATE,'DD')

UNION

select 0 INFORMATION, count(*) RECLAMATION, 0 REFUS, 0 RECHERCHE,trunc(LASTDATE,'DD') DATE_CLOTURE from 
( 
SELECT max(EvtDate) LASTDATE,doc_id from ( 
SELECT          
      EVT.EVT_ID as EvtID,          
      EVT.GEVT_ID as GevtId,          
      EVT.TEVT_ID as TevId,          
      EVT.EVT_DATE As EvtDate,          
      EVT.EVT_NB,          
      EVT.USR_ID as UsrId,    
      DOC.DOC_ID as DOC_ID,         
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,          
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,          
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache          
  
   FROM          
      EVT_ACTIONDOC DOC,          
      EVT_AIRS      EVT          
        
   WHERE          
      EVT.EVT_ID = DOC.EVT_ID          
      AND          
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow')          
      AND     
      EVT.EVT_DATE BETWEEN ? AND ? 
      ) 
group by doc_id 
) CLOS, 
docref_docsal DREF  
where DREF.doc_id=CLOS.doc_id and fld_id=33 and DREF.aui_id=171 and DREF.doc_id in (  
select doc_id from docref_docsal where fld_id=27 and aui_id=101  
) group by trunc(LASTDATE,'DD')

UNION

select 0 INFORMATION, 0 RECLAMATION, count(*) REFUS, 0 RECHERCHE,trunc(LASTDATE,'DD') DATE_CLOTURE from 
( 
SELECT max(EvtDate) LASTDATE,doc_id from ( 
SELECT          
      EVT.EVT_ID as EvtID,          
      EVT.GEVT_ID as GevtId,          
      EVT.TEVT_ID as TevId,          
      EVT.EVT_DATE As EvtDate,          
      EVT.EVT_NB,          
      EVT.USR_ID as UsrId,    
      DOC.DOC_ID as DOC_ID,         
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,          
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,          
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache          
  
   FROM          
      EVT_ACTIONDOC DOC,          
      EVT_AIRS      EVT          
        
   WHERE          
      EVT.EVT_ID = DOC.EVT_ID          
      AND          
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow')          
      AND     
      EVT.EVT_DATE BETWEEN ? AND ? 
      ) 
group by doc_id 
) CLOS, 
docref_docsal DREF  
where DREF.doc_id=CLOS.doc_id and fld_id=33 and DREF.aui_id=172 and DREF.doc_id in (  
select doc_id from docref_docsal where fld_id=27 and aui_id=101  
) group by trunc(LASTDATE,'DD')

UNION

select 0 INFORMATION, 0 RECLAMATION, 0 REFUS, count(*) RECHERCHE,trunc(LASTDATE,'DD') DATE_CLOTURE from 
( 
SELECT max(EvtDate) LASTDATE,doc_id from ( 
SELECT          
      EVT.EVT_ID as EvtID,          
      EVT.GEVT_ID as GevtId,          
      EVT.TEVT_ID as TevId,          
      EVT.EVT_DATE As EvtDate,          
      EVT.EVT_NB,          
      EVT.USR_ID as UsrId,    
      DOC.DOC_ID as DOC_ID,         
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,          
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,          
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache          
  
   FROM          
      EVT_ACTIONDOC DOC,          
      EVT_AIRS      EVT          
        
   WHERE          
      EVT.EVT_ID = DOC.EVT_ID          
      AND          
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow')          
      AND     
      EVT.EVT_DATE BETWEEN ? AND ? 
      ) 
group by doc_id 
) CLOS, 
docref_docsal DREF
where DREF.doc_id=CLOS.doc_id and fld_id=33 and DREF.aui_id=173 and DREF.doc_id in (  
select doc_id from docref_docsal where fld_id=27 and aui_id=101  
) group by trunc(LASTDATE,'DD')
)group by DATE_CLOTURE</property>
        </oda-data-set>
    </data-sets>
