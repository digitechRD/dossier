                    <property name="dataType">dateTime</property>
                    <property name="position">5</property>
                    <expression name="defaultValue">java.text.DateFormat.getDateInstance(java.text.DateFormat.SHORT, java.util.Locale.FRANCE).parse("01/01/2005")</expression>
                    <property name="isInput">true</property>
                </structure>
