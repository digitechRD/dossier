                <list-property name="paramBindings">
                    <structure>
                        <property name="paramName">Date de début</property>
                        <expression name="expression">java.text.DateFormat.getDateInstance(java.text.DateFormat.SHORT, java.util.Locale.FRANCE).format(new java.text.SimpleDateFormat("EEE MMM d HH:mm:ss z yyyy", java.util.Locale.US).parse(params["Date de début"]))</expression>
                    </structure>
                    <structure>
                        <property name="paramName">Date de fin</property>
                        <expression name="expression">java.text.DateFormat.getDateInstance(java.text.DateFormat.SHORT, java.util.Locale.FRANCE).format(new java.text.SimpleDateFormat("EEE MMM d HH:mm:ss z yyyy", java.util.Locale.US).parse(params["Date de fin"]))</expression>
                    </structure>
                    <structure>
                        <property name="paramName">Login</property>
                        <expression name="expression">params["Login"]</expression>
                    </structure>
                    <structure>
                        <property name="paramName">birtjdbcurl</property>
