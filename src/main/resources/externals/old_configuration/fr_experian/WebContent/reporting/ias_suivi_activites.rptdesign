            <property name="queryText">select QUALIF,max(INDEXESPARTIELLEMENT),max(INDEXESTOTALEMENT),max(QUALIFIES),max(ATTENTE),max(TRAITE) from( 
select DECODE(QUALIFICATION,null,'Non qualifiés',QUALIFICATION) QUALIF, count(*) INDEXESPARTIELLEMENT,0 INDEXESTOTALEMENT,0 QUALIFIES,0 ATTENTE,0 TRAITE from      
(      
SELECT       
      EVT.EVT_ID as EvtID,       
      EVT.GEVT_ID as GevtId,       
      EVT.TEVT_ID as TevId,       
      EVT.EVT_DATE As EvtDate,       
      EVT.EVT_NB,       
      EVT.USR_ID as UsrId,       
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache,       
      DS.CTY_ID,    
      AU.AUI_VALUE1 as QUALIFICATION      
   FROM       
      EVT_ACTIONDOC DOC,       
      EVT_AIRS      EVT,       
      (select * from DOCREF_DOCSAL where fld_id = 33) DS,   
      AUTHORITY_ITEM AU, 
      USERS USR,USER_ORGA UGO              
   WHERE       
      EVT.EVT_ID = DOC.EVT_ID       
      AND       
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow') 
      AND  
      EVT.USR_ID =UGO.USR_ID  
      AND  
      UGO.ORG_ID=3  
      AND  
      USR.USR_ID=EVT.USR_ID 
      AND  
      EVT.EVT_DATE BETWEEN ? AND ?  
      AND  
      USR_LOGIN like ?       
      AND   
      DS.AUI_ID=AU.AUI_ID (+)   
      AND        
      DS.DOC_ID (+)= DOC.DOC_ID        
            
)  
WHERE taskname='indexationIAS' and sortietache='validater'  
  
group by QUALIFICATION 
 
UNION 
 
select DECODE(QUALIFICATION,null,'Non qualifiés',QUALIFICATION) QUALIF, 0 INDEXESPARTIELLEMENT,count(*) INDEXESTOTALEMENT,0 QUALIFIES,0 ATTENTE,0 TRAITE from      
(      
SELECT       
      EVT.EVT_ID as EvtID,       
      EVT.GEVT_ID as GevtId,       
      EVT.TEVT_ID as TevId,       
      EVT.EVT_DATE As EvtDate,       
      EVT.EVT_NB,       
      EVT.USR_ID as UsrId,       
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache,       
      DS.CTY_ID,      
      AU.AUI_VALUE1 as QUALIFICATION   
   FROM       
      EVT_ACTIONDOC DOC,       
      EVT_AIRS      EVT,       
      (select * from DOCREF_DOCSAL where fld_id = 33) DS,   
      AUTHORITY_ITEM AU, 
      USERS USR,USER_ORGA UGO         
   WHERE       
      EVT.EVT_ID = DOC.EVT_ID       
      AND       
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow')  
      AND  
      EVT.USR_ID =UGO.USR_ID  
      AND  
      UGO.ORG_ID=3  
      AND  
      USR.USR_ID=EVT.USR_ID 
      AND  
      EVT.EVT_DATE BETWEEN ? AND ?  
      AND  
      USR_LOGIN like ?      
      AND   
      DS.AUI_ID=AU.AUI_ID (+)   
      AND        
      DS.DOC_ID (+)= DOC.DOC_ID        
            
)   
where taskname='indexationApresEnrichissementIAS' and sortietache='validater'  
    
group by QUALIFICATION 
 
UNION 
 
select DECODE(QUALIFICATION,null,'Non qualifiés',QUALIFICATION) QUALIF,0 INDEXESPARTIELLEMENT,0 INDEXESTOTALEMENT, count(*) QUALIFIES,0 ATTENTE,0 TRAITE from      
(      
SELECT       
      EVT.EVT_ID as EvtID,       
      EVT.GEVT_ID as GevtId,       
      EVT.TEVT_ID as TevId,       
      EVT.EVT_DATE As EvtDate,       
      EVT.EVT_NB,       
      EVT.USR_ID as UsrId,       
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache,       
      DS.CTY_ID,   
      AU.AUI_VALUE1 as QUALIFICATION       
   FROM       
      EVT_ACTIONDOC DOC,       
      EVT_AIRS      EVT,       
      (select * from DOCREF_DOCSAL where fld_id = 33) DS,   
      AUTHORITY_ITEM AU, 
      USERS USR,USER_ORGA UGO         
   WHERE       
      EVT.EVT_ID = DOC.EVT_ID       
      AND       
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow')  
      AND  
      EVT.USR_ID =UGO.USR_ID  
      AND  
      UGO.ORG_ID=3  
      AND  
      USR.USR_ID=EVT.USR_ID 
      AND  
      EVT.EVT_DATE BETWEEN ? AND ?  
      AND  
      USR_LOGIN like ?      
      AND   
      DS.AUI_ID=AU.AUI_ID (+)   
      AND        
      DS.DOC_ID (+)= DOC.DOC_ID       
            
) 
where (taskname='AutreRejetAQualifer' and sortietache='a traiter')  
OR  
  (taskname='CourrierAQualifier' and sortietache='validater')  
 
group by QUALIFICATION 
 
UNION 
 
select DECODE(QUALIFICATION,null,'Non qualifiés',QUALIFICATION) QUALIF, 0 INDEXESPARTIELLEMENT,0 INDEXESTOTALEMENT, 0 QUALIFIES ,count(*) ATTENTE,0 TRAITE from      
(      
SELECT       
      EVT.EVT_ID as EvtID,       
      EVT.GEVT_ID as GevtId,       
      EVT.TEVT_ID as TevId,       
      EVT.EVT_DATE As EvtDate,       
      EVT.EVT_NB,       
      EVT.USR_ID as UsrId,       
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache,       
      DS.CTY_ID,       
      AU.AUI_VALUE1 as QUALIFICATION   
   FROM       
      EVT_ACTIONDOC DOC,       
      EVT_AIRS      EVT,       
      (select * from DOCREF_DOCSAL where fld_id = 33) DS,   
      AUTHORITY_ITEM AU, 
      USERS USR,USER_ORGA UGO        
   WHERE       
      EVT.EVT_ID = DOC.EVT_ID       
      AND       
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow')   
      AND  
      EVT.USR_ID =UGO.USR_ID  
      AND  
      UGO.ORG_ID=3  
      AND  
      USR.USR_ID=EVT.USR_ID 
      AND  
      EVT.EVT_DATE BETWEEN ? AND ?  
      AND  
      USR_LOGIN like ?     
      AND   
      DS.AUI_ID=AU.AUI_ID (+)   
      AND        
      DS.DOC_ID (+)= DOC.DOC_ID       
            
) 
where (taskname='AutreRejetAQualifer' and sortietache='mettre en attente')  
OR  
  (taskname='CourrierARepondre' and sortietache='Mettre en attente')  
    
group by QUALIFICATION 
 
UNION 
 
select DECODE(QUALIFICATION,null,'Non qualifiés',QUALIFICATION) QUALIF, 0 INDEXESPARTIELLEMENT,0 INDEXESTOTALEMENT, 0 QUALIFIES ,0 ATTENTE, count(*) TRAITE from       
(       
SELECT        
      EVT.EVT_ID as EvtID,        
      EVT.GEVT_ID as GevtId,        
      EVT.TEVT_ID as TevId,        
      EVT.EVT_DATE As EvtDate,        
      EVT.EVT_NB,        
      EVT.USR_ID as UsrId,        
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,        
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,        
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache,        
      DS.CTY_ID,   
      AU.AUI_VALUE1 as QUALIFICATION   
   FROM        
      EVT_ACTIONDOC DOC,        
      EVT_AIRS      EVT,        
      (select * from DOCREF_DOCSAL where fld_id = 33) DS,   
      AUTHORITY_ITEM AU, 
      USERS USR,USER_ORGA UGO         
   WHERE        
      EVT.EVT_ID = DOC.EVT_ID        
      AND        
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow')  
      AND  
      EVT.USR_ID =UGO.USR_ID  
      AND  
      UGO.ORG_ID=3  
      AND  
      USR.USR_ID=EVT.USR_ID 
      AND  
      EVT.EVT_DATE BETWEEN ? AND ?  
      AND  
      USR_LOGIN like ?       
      AND   
      DS.AUI_ID=AU.AUI_ID (+)   
      AND        
      DS.DOC_ID (+)= DOC.DOC_ID  
             
)  
 where (taskname='AutreRejetAQualifer' and (sortietache='cloturer' or sortietache='a traiter'))   
OR   
  (taskname='CourrierARepondre' and (sortietache='Valider' or sortietache='Transfert autres rejets'))   
     
group by QUALIFICATION 
) 
group by QUALIF</property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="UtilisateursIAS" id="162">
            <property name="dataSource">AIRS_MEDIADOC</property>
            <property name="queryText">select USR_LOGIN
from USERS,USER_ORGA
where USERS.USR_ID=USER_ORGA.USR_ID
AND
ORG_ID=3</property>
