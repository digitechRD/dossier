        <text-data id="53">
            <property name="style">airslineheaderclass</property>
            <expression name="valueExpr">params["Login"]+": Suivi d'activités "+java.text.DateFormat.getDateInstance(java.text.DateFormat.SHORT, java.util.Locale.FRANCE).format(params["Date de début"]) + " au "+ java.text.DateFormat.getDateInstance(java.text.DateFormat.SHORT, java.util.Locale.FRANCE).format(params["Date de fin"])</expression>
            <property name="contentType">html</property>
        </text-data>
