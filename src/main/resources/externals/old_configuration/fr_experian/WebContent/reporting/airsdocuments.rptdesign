                <structure>
                    <property name="name">fin1</property>
                    <property name="dataType">dateTime</property>
                    <property name="position">2</property>
                    <expression name="defaultValue">new java.util.Date()</expression>
                    <property name="isInput">true</property>
                </structure>
            </list-property>
            <property name="queryText">select TRUNC(D_CREAT,'DD'),count(*)  from DOC_DOCPERS
where D_CREAT BETWEEN ? AND ?
group by TRUNC(D_CREAT,'DD')</property>
        </oda-data-set>
