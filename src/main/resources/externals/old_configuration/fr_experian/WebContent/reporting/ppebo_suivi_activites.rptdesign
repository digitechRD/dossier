      USR.USR_ID=EVT.USR_ID
      AND 
      EVT.EVT_DATE BETWEEN ? AND ? 
      AND 
      USR_LOGIN like ?      
      AND        
      DS.DOC_ID = DOC.DOC_ID
            
) 
 where (taskname='TraitementAVerifier')  
   and
  NUMSTATUT IS NOT NULL
    
group by NUMSTATUT

UNION

select NUMSTATUT STATUT, 0 INDEXESPARTIELLEMENT,0 INDEXESTOTALEMENT,0 ATTENTE,0 TRAITE,0 VERIFIES,count(*) CLOTURES,0 COURRIER_ATTENTE,0 COURRIER_TRAITES from      
(      
SELECT       
      EVT.EVT_ID as EvtID,       
      EVT.GEVT_ID as GevtId,       
      EVT.TEVT_ID as TevId,       
      EVT.EVT_DATE As EvtDate,       
      EVT.EVT_NB,       
      EVT.USR_ID as UsrId,       
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache,       
      DS.CTY_ID,  
      DS.NUMSTATUT as NUMSTATUT  
   FROM       
      EVT_ACTIONDOC DOC,       
      EVT_AIRS      EVT,       
      DOC_DOCSAL DS,
      USERS USR,USER_ORGA UGO        
   WHERE       
      EVT.EVT_ID = DOC.EVT_ID       
      AND       
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow') 
      AND 
      EVT.USR_ID =UGO.USR_ID 
      AND 
      UGO.ORG_ID=2 
      AND 
      USR.USR_ID=EVT.USR_ID
      AND 
      EVT.EVT_DATE BETWEEN ? AND ? 
      AND 
      USR_LOGIN like ?      
      AND        
      DS.DOC_ID = DOC.DOC_ID 
            
) 
 where (taskname='AutreRejetATraiter' and (sortietache='a clore'))
 OR
 (taskname='CourrierAutreRejetATraiter' and (sortietache='a clore'))  
   and
  NUMSTATUT IS NOT NULL
    
group by NUMSTATUT
UNION

select NUMSTATUT STATUT, 0 INDEXESPARTIELLEMENT,0 INDEXESTOTALEMENT,0 ATTENTE,0 TRAITE,0 VERIFIES, 0 CLOTURES,count(*) COURRIER_ATTENTE,0 COURRIER_TRAITES from      
(      
SELECT       
      EVT.EVT_ID as EvtID,       
      EVT.GEVT_ID as GevtId,       
      EVT.TEVT_ID as TevId,       
      EVT.EVT_DATE As EvtDate,       
      EVT.EVT_NB,       
      EVT.USR_ID as UsrId,       
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache,       
      DS.CTY_ID,  
      DS.NUMSTATUT as NUMSTATUT  
   FROM       
      EVT_ACTIONDOC DOC,       
      EVT_AIRS      EVT,       
      DOC_DOCSAL DS,
      USERS USR,USER_ORGA UGO        
   WHERE       
      EVT.EVT_ID = DOC.EVT_ID       
      AND       
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow') 
      AND 
      EVT.USR_ID =UGO.USR_ID 
      AND 
      UGO.ORG_ID=2 
      AND 
      USR.USR_ID=EVT.USR_ID
      AND 
      EVT.EVT_DATE BETWEEN ? AND ? 
      AND 
      USR_LOGIN like ?      
      AND        
      DS.DOC_ID = DOC.DOC_ID
            
) 
 where (taskname='CourrierAutreRejetATraiter' and (sortietache='mettre en attente'))   
   and
  NUMSTATUT IS NOT NULL
    
group by NUMSTATUT
UNION

select NUMSTATUT STATUT, 0 INDEXESPARTIELLEMENT,0 INDEXESTOTALEMENT,0 ATTENTE,0 TRAITE,0 VERIFIES, 0 CLOTURES,0 COURRIER_ATTENTE,count(*) COURRIER_TRAITES from      
(      
SELECT       
      EVT.EVT_ID as EvtID,       
      EVT.GEVT_ID as GevtId,       
      EVT.TEVT_ID as TevId,       
      EVT.EVT_DATE As EvtDate,       
      EVT.EVT_NB,       
      EVT.USR_ID as UsrId,       
      SUBSTR(DOC.DOC_COMMENT, 1                                    , INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1                                    ) as idTache,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 1) + 1, INSTR(DOC.DOC_COMMENT, ':', 1, 2) - INSTR(DOC.DOC_COMMENT, ':', 1, 1) - 1) as taskname,       
      SUBSTR(DOC.DOC_COMMENT, INSTR(DOC.DOC_COMMENT, ':', 1, 2) + 1                                                                           ) as sortieTache,       
      DS.CTY_ID,  
      DS.NUMSTATUT as NUMSTATUT  
   FROM       
      EVT_ACTIONDOC DOC,       
      EVT_AIRS      EVT,       
      DOC_DOCSAL DS,
      USERS USR,USER_ORGA UGO        
   WHERE       
      EVT.EVT_ID = DOC.EVT_ID       
      AND       
      EVT.TEVT_ID in (select TEVT_ID from EVT_TYPE where TEVT_DESC = 'Valider Workflow') 
      AND 
      EVT.USR_ID =UGO.USR_ID 
      AND 
      UGO.ORG_ID=2 
      AND 
      USR.USR_ID=EVT.USR_ID
      AND 
      EVT.EVT_DATE BETWEEN ? AND ? 
      AND 
      USR_LOGIN like ?      
      AND        
      DS.DOC_ID = DOC.DOC_ID
            
) 
 where (taskname='CourrierAutreRejetATraiter' and (sortietache='a clore' or sortietache='a saisir' or sortietache='a qualifier'))  
  and
  NUMSTATUT IS NOT NULL
    
group by NUMSTATUT
)
group by  decode(STATUT,'CL','Clos','VR','A vérifier','QR','A qualifier','LT','Rejet lettre type','RJ','Autre rejet',STATUT)
</property>
