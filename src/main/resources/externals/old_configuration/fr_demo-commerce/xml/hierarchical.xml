    <organization name="WKF" id="21">
        <contentType name="WKF_PES_FAST_DOSSIER" visible="true">
            <libelle>{WKF_NOMFIC}</libelle>
            <sorting/>
        </contentType>
        <contentType name="WKF_PES_FAST_DOCUMENT" visible="true">
            <libelle>{WKF_NOMFIC}</libelle>
            <sorting/>
        </contentType>
        <contentType name="GF_PES_SRCI_BUDGET" visible="true">
            <libelle>{WKF_BUDGET} - {WKF_EXERCICE}</libelle>
            <sorting/>
        </contentType>
        <contentType name="GF_PES_SRCI" visible="true">
            <libelle>{WKF_BUDGET} - {WKF_EXERCICE}</libelle>
