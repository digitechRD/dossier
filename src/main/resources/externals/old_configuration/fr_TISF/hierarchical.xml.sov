<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<hierarchique xmlns="http://www.digitech.com/dossiers/hierarchical" xmlns:ns2="http://www.digitech.com/dossiers/common" customerName="Digitech" version="5.1-SNAPSHOT">
    <organization id="0" name="DEFAULT">
    </organization>
    <organization id="3" name="RH">
        <contentType name="DOSSIER_RH" visible="true">
            <libelle>{RH_MATRICULE} - {RH_NOM}{RH_PRENOM}</libelle>
            <sorting/>
        </contentType>
        <contentType name="DOCUMENT_RH" visible="true">
            <libelle dateFormat="dd/MM/yyyy">{RH_LIBELLE} {RH_DATE_DOC}</libelle>
            <field_hier>RH_DOC_CAT</field_hier>             
            <field_hier>RH_TYPE_DOC</field_hier>
            <sorting>
                <ns2:sortingPolicy>
                    <ns2:direction>DICREASING</ns2:direction>
                    <ns2:codeField>D_CREAT</ns2:codeField>
                </ns2:sortingPolicy>
            </sorting>
        </contentType>
    </organization>
</hierarchique>
