<jsp:root version="2.0" xmlns:f="http://java.sun.com/jsf/core"
	xmlns:h="http://java.sun.com/jsf/html"
	xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:webuijsf="http://www.sun.com/webui/webuijsf"
	xmlns:a4j="http://richfaces.org/a4j"
	xmlns:rich="http://richfaces.org/rich"
	xmlns:dossier="http://dossier.digitech.com/jsf/html">
	
	<f:view>
		<webuijsf:page id="exportToEdit">
			<webuijsf:html id="html">
			<webuijsf:head id="head"
				title="ExportToEdit"
				parseOnLoad="false" webuiAll="true">
				<webuijsf:meta httpEquiv="Content-Type"
					content="text/html;charset=UTF-8" />
					<webuijsf:script type="text/javascript">
						function redirect(url, label)
						{
							var myshell = new ActiveXObject("Shell.Application");
							myshell.ShellExecute("iexplore.exe", " -nomerge -noframemerging " + url, "", "open", 1);					
						}      
					</webuijsf:script>
			</webuijsf:head>
			<webuijsf:body id="body">
			
				<h:panelGroup layout="block">
					<script type="text/javascript">					
						if("#{CustomActionModel.modalPanelModel.STATE}" == "OK"){
							window.open('#{CustomActionModel.modalPanelModel.LINK}', 'AirsDossier', 'status=yes, scrollbars=yes, menubar=yes, resizable=yes, width=1300, height=750');
						}
						setTimeout('window.close()',500);
					</script>
				</h:panelGroup>

			</webuijsf:body>
			</webuijsf:html>
		</webuijsf:page>
	</f:view>

</jsp:root>