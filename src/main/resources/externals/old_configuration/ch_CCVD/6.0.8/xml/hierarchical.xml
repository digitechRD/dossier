<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ns2:hierarchique xmlns="http://www.digitech.com/dossiers/common" xmlns:ns2="http://www.digitech.com/dossiers/hierarchical" customerName="ESH" version="4.1.4">
    <ns2:organization id="0" name="DEFAULT">

        <ns2:contentType visible="true" name="DOSSIER_AFFILIE">
	     	<link direction="child" name="annexe" contentTypeCode="DOCUMENT_AFFILIE"/>
            <ns2:libelle>Dossier affilie {N_AFF}</ns2:libelle>
		<ns2:treeNode-properties-scriptId>ExpendTreeHierarchicalView</ns2:treeNode-properties-scriptId>
        </ns2:contentType>
		
        <ns2:contentType visible="true" name="DOCUMENT_AFFILIE">
			<link direction="child" name="annexe" contentTypeCode="DOCUMENT_AFFILIE"/>
			<link direction="child" name="copie" contentTypeCode="DOCUMENT_AFFILIE"/>			
		    <ns2:libelle dateFormat="dd/MM/yyyy">{COM} pour {NOM_AFF} {PRENOM_AFF} du {D_CREAT}</ns2:libelle>
		    <ns2:field_hier>AL_CAISSE</ns2:field_hier>
		    <ns2:field_hier>AL_SERVICE</ns2:field_hier>			    
		    <ns2:field_hier>AL_CATEGORIE</ns2:field_hier>
			<!-- <ns2:treeNode-properties-scriptId>ExpendTreeHierarchicalView</ns2:treeNode-properties-scriptId> -->
		     <sorting>            	
	            	 <ns2:sortingPolicy>
				<ns2:direction>DICREASING</ns2:direction>
				<ns2:codeField>D_CREAT</ns2:codeField>
	                </ns2:sortingPolicy>
		     </sorting>
        </ns2:contentType>
		
		<ns2:contentType visible="true" name="DOSSIER_LISTE">
            <ns2:libelle>Dossier liste {N_AFF_LST}</ns2:libelle>
        </ns2:contentType>

        <ns2:contentType visible="true" name="DOCUMENT_LISTE">
		    <link direction="parent" name="liste" contentTypeCode="DOCUMENT_AFFILIE"/>
		    <ns2:libelle dateFormat="dd/MM/yyyy">{AL_TYPE_LST} du {D_CREAT}</ns2:libelle>
		    <ns2:field_hier>AL_TYPE_LST</ns2:field_hier>			
        </ns2:contentType>
		
		<ns2:contentType visible="true" name="DOSSIER_ENREGISTREMENT">
            <ns2:libelle>Dossier enregistrement {N_NE}</ns2:libelle>
        </ns2:contentType>
        <ns2:contentType visible="true" name="DOCUMENT_ENREGISTREMENT">
		    <ns2:libelle dateFormat="dd/MM/yyyy">{AL_TYPE} du {D_CREAT}</ns2:libelle>
		    <ns2:field_hier>AL_TYPE</ns2:field_hier>
        </ns2:contentType>
		
		<ns2:contentType visible="true" name="DOSSIER_AVIS_MUTATION">
            <ns2:libelle>Dossier avis de mutation {N_AVIS_MUTATION}</ns2:libelle>
        </ns2:contentType>
		
		<ns2:contentType visible="true" name="DOCUMENT_AVIS_MUTATION">
		    <ns2:libelle dateFormat="dd/MM/yyyy">{D_CREAT}</ns2:libelle>
        </ns2:contentType>
		
    </ns2:organization>
</ns2:hierarchique>
