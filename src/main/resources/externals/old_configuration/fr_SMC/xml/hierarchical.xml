<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ns2:hierarchique xmlns="http://www.digitech.com/dossiers/common" xmlns:ns2="http://www.digitech.com/dossiers/hierarchical" customerName="SMC" version="5.1-SNAPSHOT">
    <ns2:organization id="0" name="DEFAULT">
        <ns2:contentType name="DOSSIER" visible="true">
            <ns2:libelle>Dossier - {SIREN}</ns2:libelle>
            <ns2:sorting/>
        </ns2:contentType>
        <ns2:contentType name="DOCUMENT" visible="true">
            <ns2:libelle dateFormat="dd/MM/yyyy">Document ({DATE_CLOTURE})</ns2:libelle>
            <ns2:field_hier>TYPE_DOC</ns2:field_hier>
            <ns2:sorting>
                <sortingPolicy>
                    <direction>ASCENDING</direction>
                    <codeField>DATE_CLOTURE</codeField>
                </sortingPolicy>
            </ns2:sorting>
        </ns2:contentType>
        <ns2:contentType name="DOSJUR" visible="true">
            <ns2:libelle dateFormat="dd/MM/yyyy">{GENRE}</ns2:libelle>
            <ns2:sorting/>
        </ns2:contentType>
        <ns2:contentType name="DOSCLI" visible="true">
            <ns2:libelle>Dossier Client ({NOM} {PRENOM} {NUMCPTREF})</ns2:libelle>
            <ns2:sorting/>
        </ns2:contentType>
        <ns2:contentType name="DOCJUR" visible="true">
            <ns2:libelle dateFormat="dd/MM/yyyy">{TYPEDOCJUR} ({D_CREAT}) {PRESENTREREL}</ns2:libelle>
            <ns2:sorting>
                <sortingPolicy>
                    <direction>DICREASING</direction>
                    <codeField>D_CREAT</codeField>
                </sortingPolicy>
            </ns2:sorting>
        </ns2:contentType>
    </ns2:organization>
</ns2:hierarchique>
