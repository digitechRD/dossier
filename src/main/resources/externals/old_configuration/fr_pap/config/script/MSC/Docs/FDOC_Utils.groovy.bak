	/**
	* Verifie si l'utilisateur connecte est le signataire courant du document (base sur le champ FDOC_CUR_SIGNATAIRE).
	* @param userContext le contexte de l'utilisateur connecte
	* @param document le document AIRS
	* @return true si l'utilisateur connecte est le signataire courant
	*/
    public static boolean isSignerUser(UserContext userContext, IDocument document) 
	{
        Integer docSigner = FieldUtils.getValue(document, getConstant("FIELD_CODE_SIGNER_USER"));
        return docSigner != null && docSigner.equals(userContext.getUser().getId());
    }
	
	/**
	* Renvoie l'id d'un item de liste d'autorite en fonction du code.
	* @param fieldCode le code du champ (liste autorite)
	* @param termCode le code de l'item de liste d'autorite
	* @return l'id de l'item
	* @throws IdentificationException
	* @throws ServerException
	*/
    public static Integer getTermID(String fieldCode, String termCode) throws IdentificationException, ServerException 
	{
        List<Term> termList = CourrierUtils.getAuthorityListMgr().getTerms(fieldCode);
        for (Term term : termList) 
		{
            if (term.getCode().equals(termCode)) 
			{
                return term.getId();
            }
        }
        return -1;
    }
	
    /**
     * Gets a term Code.
     * @param fieldCode the field code
     * @param termId the term Id
     * @return the term Code
     * @throws IdentificationException
     * @throws ServerException
     */
    public static String getTermCode(String fieldCode, Integer termId) throws IdentificationException, ServerException
	{
        List<Term> termList = CourrierUtils.getAuthorityListMgr().getTerms(fieldCode);
        for(Term term : termList) {
            if(term.getId().equals(termId)) {
                return term.getCode();
            }
        }
        return null;
    }

	/**
	* Retourne le code du service en fonction d'un id
	* @param orgId l'id du service
	* @param userContext le contexte de l'utilisateur connecte
	* @return service le code du service
	*/
    private static String getServiceCode(Integer orgId, UserContext userContext) throws IdentificationException, ServerException 
	{
        String serviceCode = null;
        OrganizationAdmin orgAdm = OrganizationsManager.load(userContext.getJeton(), orgId);
        if (orgAdm != null) 
		{
            serviceCode = orgAdm.getCode();
        }
        return serviceCode;
    }
	
	/**
	* Retourne la liste des utilisateurs possedant le profil profileCode
	* @param profileCode le code du profil concerne
	* @return elements la liste des utilisateurs possedant le profil
	*/
    public static List<User> getUsersFromProfile(String profileCode) 
	{
		String methodName = "getUsersFromProfile";
        List<User> elements = new ArrayList<User>();

        //Chargement du profil
        IProfile profile = getRightMgr().getProfile(profileCode);
        if (profile != null) 
		{
            ProfilAdmin currentProfil = com.digitech.jcorbairs.admin.ProfilsManager.load(DossierCoreContext.getAdminJeton(), profile.getId().intValue());
            if (currentProfil != null) 
			{
                // Recuperation de tous les utilisateurs qui ont le profil
                List<UserAdmin> userAdmList = currentProfil.getUsers();
                if (userAdmList != null && userAdmList.size() > 0) {
                    User user;
                    for (UserAdmin usrAdm : userAdmList) 
					{
                        if ((user = getUserMgr().getUser(usrAdm.getId())) != null) 
						{
							log.debug(methodName+" :  Ajout de l'utilisateur "+user.getLogin());
                            elements.add(user);
                        }
                    }
                }
            }
        }
        return elements;
    }
	
	/**
	* Retourne la liste des utilisateurs possedant le profil profileCode et faisant partie de la societe socCode
	* @param profileCode le code du profil concerne
	* @param socCode le code de la societe concernee
	* @return elements la liste des utilisateurs possedant le profil de la societe socCode
	*/
    public static List<User> getUsersFromProfileAndSociety(String profileCode, String socCode) 
	{
		String methodName = "getUsersFromProfileAndSociety";
        List<User> elements = new ArrayList<User>();

        //Chargement du profil
        IProfile profile = getRightMgr().getProfile(profileCode);
		
        if (profile != null) 
		{
            ProfilAdmin currentProfil = com.digitech.jcorbairs.admin.ProfilsManager.load(DossierCoreContext.getAdminJeton(), profile.getId().intValue());
            if (currentProfil != null) 
			{
                //Recuperation de tous les utilisateurs qui ont le profil
                List<UserAdmin> userAdmList = currentProfil.getUsers();
				
                if (userAdmList != null && userAdmList.size() > 0) 
				{
                    User user;
					
                    for (UserAdmin usrAdm : userAdmList) 
					{
                        if ((user = getUserMgr().getUser(usrAdm.getId())) != null) 
						{
							//Verification de l'appartenance de l'utilisateur e la societe socCode
							List<Organization> orgaList = user.getOrganizations();
							boolean userIsFromSoc = false;
							
							if(orgaList!=null)
							{
								for (Organization orga : orgaList) 
								{
									if(orga.getProperties().getCode().contains(socCode+"_"))
									{
										userIsFromSoc = true;
									}
								}
								
								if(userIsFromSoc)
								{
									log.debug(methodName+" : Ajout de l'utilisateur "+user.getLogin());
									elements.add(user);
								}
							}
                        }
                    }
                }
            }
        }
        return elements;
    }

	/**
	* Retourne la liste du champ selectionne faisant partie de la societe socCode
	* @param socCode le code de la societe concernee
	* @return elements de la liste du champ choisi en fonction de la societe socCode
	*/
	public static List<Term> getTermsFromSociety(String fieldCode, String socCode) 
	{
		String methodName = "getFieldFromSociety";
		
		List<Term> termList = CourrierUtils.getAuthorityListMgr().getTerms(fieldCode);
		List<Term> elements = new ArrayList<Term>();
		
		if (termList != null) 
		{
			for (Term term : termList) 
			{			
				if(term.getCode().contains(socCode+"_"))
				{
					elements.add(term);
					log.debug(methodName+" : Ajout du codeTerm : "+term.getCode());
				}
			}
		}
		return elements;
	}
	
	/**
	* Retourne le code de la societe du document (si le document a une societe)
	* @param document le document
	* @return socCode le code de la societe du document, chaine nulle si pas de societe sur le document
	*/
    public static String getSocietyCodeFromDocument(IDocument document) 
	{
		String methodName = "getSocietyCodeFromDocument";
		String fieldCodeSociety = getConstant("FIELD_CODE_SOCIETE");
		String socCode = null;
		Integer socId = (Integer) document.getField(fieldCodeSociety).getValue();
		
		log.debug(methodName+" : fieldCode : " + fieldCodeSociety+ " - " + methodName+" : socId = "+socId);
		
        if (socId != null) 
		{
            Term term = ((IAuthorityList) getAuthorityListService()).getTerm(socId);
            if (term == null) 
			{
               log.error(methodName+" : Aucun terme avec l'ID '" + socId + "' trouve pour la liste d'autorite " + fieldCodeSociety);
            }
			else
			{
				socCode = term.getCode();
			}
		}
        
		return socCode;
	}
	
	/**
	* Retourne le code de la societe de l'utilisateur en fonction du service auquel il est connecte
	* @param UserContext userContext : le contexte de l'utilisateur connecte
	* @return socCode le code de la societe de l'utilisateur
	*/
    public static String getSocietyCodeFromUserContext(UserContext userContext) 
	{
		String methodName = "getSocietyCodeFromUserContext";
		String socCode = null;
		String serviceCode = null;

		// Recuperation du service courant de l'utilisateur connecte
		serviceCode = getServiceCode(userContext.getCurrentOrgId(), userContext);
		
		log.debug(methodName+" : serviceCode : " + serviceCode);
		
		// Recuperation du debut du code du service de l'utilisateur connecte
		socCode = serviceCode.substring(0, serviceCode.indexOf("_"));
		
		log.debug(methodName+" : socCode : " + socCode);
        
		return socCode;
	}
	
	/**
	* Verifie si l'utilisateur est un contributeur sur le document.
	* @param userContext : Le contexte de l'utilisateur courant.
	* @param document : Le document AIRS.
	* @return true si l'utilisateur est un contributeur sur le document.
	*/
	public static boolean isCollaboratorUser(UserContext userContext, IDocument document)
	{
		String fieldCodeDocumentCollaboratorUser = getConstant("FIELD_CODE_COLLABORATOR");
		List<Integer> docCollaborators = null;
		try
		{
			docCollaborators = FieldUtils.getValues(document, fieldCodeDocumentCollaboratorUser);
		}
		catch(IllegalStateException ise)
		{
			log.error("isCollaboratorUser : "+ise.getMessage());
			return false;
		}
		return docCollaborators != null && docCollaborators.contains(userContext.getUser().getId());
	}
  
	/**
	* Retire un utilisateur de la liste des contributeurs.
	* @param userContext : Le contexte de l'utilisateur connecte.
	* @param document : Le document AIRS.
	*/
	public static void removeUserFromCollaborators(UserContext userContext, IDocument document)
	{
		String methodName = "removeUserFromCollaborators";
		String fieldCodeDocumentCollaboratorUser = getConstant("FIELD_CODE_COLLABORATOR");
		List<Integer> docCollaborators = null;
		try
		{
		  docCollaborators = FieldUtils.getValues(document, fieldCodeDocumentCollaboratorUser);
		}
		catch(IllegalStateException ise)
		{
		  log.error(methodName+" : "+ise.getMessage());
		}
	  
		Integer userId = userContext.getUser().getId();
		if(docCollaborators != null && docCollaborators.contains(userId))
		{
			// Obligation de parcourir la liste à cause de la syntaxe groovy...
			for(int i=0; i < docCollaborators.size(); i++)
			{
			  if(docCollaborators.get(i) == userId)
			  {
				docCollaborators.remove(i);
				break;
			  }
			}
			FieldUtils.setValues(document, getConstant("FIELD_CODE_COLLABORATOR"), docCollaborators);
		}
		else
		{
			log.error(methodName+" : L'utilisateur ne fait pas parti de la liste des contributeurs.");
		}
	}
	
	/**
    * Verifie si le contributeur courant est le dernier contributeur (base sur le champ FDOC_CONTRIB).
    * @param document le document AIRS
    * @return true si le contributeur courant du document est le dernier
    */
    public static boolean isLastCollaborator(UserContext userContext, IDocument document) 
	{
		String methodName = "isLastCollaborator";
        Integer docCollaborator = null;
        List<Integer> docCollaborators = null;
        try 
		{
            docCollaborator = userContext.getUser().getId();
            docCollaborators = FieldUtils.getValues(document, getConstant("FIELD_CODE_COLLABORATOR"));
        }
        catch (IllegalStateException ise) 
		{
			log.error(methodName+" : "+ise.getMessage());
        }

        return docCollaborator == null || docCollaborators.size() == 0 || docCollaborators.get(docCollaborators.size() - 1).equals(docCollaborator);
    }
	
	/**
	*  Ajoute un evenement d'historique de type changement de valeur pour un document.
	* @param document : Le document.
	* @param userContext : Le contexte utilisateur.
	* @param fieldCode : Le code du champ AIRS.
	* @param oldValue : L'ancienne valeur du champ.
	* @param newValue : La nouvelle valeur du champ.
	*
	*/
	private static void addHistoForField(IDocument document, UserCoreContext userContext, String fieldCode, String oldValue, String newValue)
	{
		// Si le document n'est pas verrouille
		if(document.getLockType() != com.digitech.dossier.common.model.backend.Constants.DOC_LOCKED_BYOTHER)
		{
		  if(newValue != null && oldValue.compareToIgnoreCase(newValue) != 0 && !fieldCode.equals("D_MODIF"))
		  {
			// Ajout dans l'historique
			String commentEvent = "Changement de valeur "+fieldCode+" : "+oldValue+" :"+newValue;
			getAuditMgr().addDocumentEvent(userContext, document, AdvancedAuditType.ADV_EVENT_FIELDCHANGE.name(), commentEvent);
		  }
		}
	}
	
	/**
	* Ajoute une entree de type workflow dans l'historique d'un document
	* @param document : Le document.
	* @param userContext : Le contexte de l'utilisateur courant.
	* @param newWorkflowValue : L'entree workflow à ajouter.
	*/
	private static void addHistoForWorkflow(IDocument document, UserCoreContext userContext,  String newWorkflowValue)
	{
		// Si le document n'est pas verrouille
		if(document.getLockType() != com.digitech.dossier.common.model.backend.Constants.DOC_LOCKED_BYOTHER)
		{
			if(newWorkflowValue != null )
			{
				// Ajout dans l'historique
				String commentEvent = "Action workflow : "+newWorkflowValue;
				getAuditMgr().addDocumentEvent(userContext, document, AdvancedAuditType.ADV_EVENT_FIELDCHANGE.name(), commentEvent);
			}
		}
	}

	/**
	* Ajoute un commentaire au document
	* @param document
	* @param userContext
	* @param newWorkflowValue
	*/
	private static void addComment(IDocument document, UserCoreContext userContext, String comment)
	{
		String methodName = "addComment";
		// Si le document n'est pas verrouille
		if(document.getLockType() != com.digitech.dossier.common.model.backend.Constants.DOC_LOCKED_BYOTHER)
		{
		  // Ajout du commentaire si la chaine n'est pas vide
		  if(comment!= null && !comment.equals(""))
		  {
			IComment commentObj = new Document.Comment();
			commentObj.setComment(comment);
			document.getComments().add(commentObj);

			log.debug(methodName+" : Enregistrement du commentaire : "+comment);
			getDocumentMgr().updateDocumentComments(userContext, document);
		  }
		  else
		  {
			log.debug(methodName+" : Le commentaire est vide");
		  }
		}
		else
		{
		  log.debug(methodName+" : Le document est verrouille");
		}
	}
	
	/**
	* Retourne le nom du modèle ODT à utiliser pour le document passer en paramètre (Generation de PJ)
	* @param document
	* @param userContext
	*/
	private static String getODTModel(IDocument document, UserCoreContext userContext)
	{
		Integer typeDoc = FieldUtils.getValue(document, getConstant("FIELD_CODE_DOCUMENT_TYPE"));

		if ((typeDoc == null) || (typeDoc==0))
			return "";
		
		Term term = getAuthorityListService().getTerm(typeDoc);

		if (term == null)
			return "";

		// Recuperation de la valeur 1 de l'item (valeur du model associe au type de document)
		String ODTModelName = term.getValues()[Integer.valueOf(getConstant("TYPEDOC_POS_VALDEF_MODEL"))];

		return(ODTModelName);
	}

	/**
	* Genère le document editable en fonction d'un modèle ODT
	* @param document
	* @param userContext
	*/
	public static void generateOdtToPdf(String odtFullFilePath, String pdfFullFilePath, String tempFullPath, List<IDocument> docList)
		throws FileNotFoundException, ServerException, IdentificationException, DocumentException, IOException, DocumentTemplateException,
			com.lowagie.text.DocumentException, DocumentOperationException
	{
		DefaultOfficeManagerConfiguration configuration =  DossierCoreContext.getParamsInfos().getOfficeConfiguration()

		OfficeManager.getInstance().startOffice(configuration);

		try {
			// Definition des fichiers (temporaires + finaux)
			File odtFile = new File(odtFullFilePath);
			File pdfFile = new File(pdfFullFilePath);

			getDocumentConversionService().convert(odtFile, pdfFile);
		}
		catch(Exception e) {
			throw new RuntimeException(e);
		}
	}

	/**
	* Genère le document editable en fonction d'un modèle ODT
	* @param document
	* @param userContext
	*/
	public static void generateDocument(String odt_templateFilePath, String odt_resultFilePath, String resultFilePath, String tempFilePath, List<IDocument> docList)
		throws FileNotFoundException, ServerException, IdentificationException, DocumentException, IOException, DocumentTemplateException,
			com.lowagie.text.DocumentException, DocumentOperationException
	{
		DefaultOfficeManagerConfiguration configuration =  DossierCoreContext.getParamsInfos().getOfficeConfiguration()

		OfficeManager.getInstance().startOffice(configuration);

		try 
		{
		  // Definition des fichiers (temporaires + finaux)
		  File odtModelFile = new File(odt_templateFilePath);
		  File odtResultFile = new File(odt_resultFilePath);
		  File resultFile = new File(resultFilePath);

		  // Definition des modèles de donnees
		  PdfRenumberFontModel pdfFont = new PdfRenumberFontModel();
		  Map<String, ReportAttachment> sectionAttachmentMap = new HashMap<String, ReportAttachment>();
		  ReportModel reportDataModel = getOdtGeneration().buildReportModel(UserContext.getInstance(), docList, sectionAttachmentMap);
		  Map<String, ReportModel> data = new HashMap<String, ReportModel>();
		  Map<String, ReportAttachment> mapReportAttachement = new HashMap<String, ReportAttachment>();
		  data.put(OdtGenerator.REPORT_MODEL_NAME, reportDataModel);

		  // etape 1
		  // Completion des variables de fusion (generation du document odt)
		  getDocumentGenerationService().generate(odtModelFile, odtResultFile, data);

		  // refresh the section
		  Map<String, SectionModel> fileSections = getDocumentInspectorService().getSectionModels(odtResultFile,  OdtGenerator.NAME_FILE_PREFIX);

		  // third step
		  // generate output file
		  getDocumentConversionService().convert(odtResultFile, resultFile);
		  if(resultFile.exists() && resultFile.canWrite()) 
		  {
			// fourth step
			// concant the final result file with the others
			Map<String, SectionModel> fileSectionsPDF = getDocumentInspectorService().getSectionModels(odtResultFile, OdtGenerator.NAME_FILE_PREFIX);
			getOdtGeneration().concatWithPdfOutput(resultFile, tempFilePath, mapReportAttachement, fileSectionsPDF, configuration);
		  }
		}
		catch(Exception e)
		{
		  throw new RuntimeException(e);
		}
	}
	
	/*
	 * @param docOnpPj the IDocument
	 * @param fullPath the path of the file to add
	 */
	public static void addPrimaryDoc(IDocument docOnpPj, String fullPath, String attachmentType)
	{
	  String fileName = FilenameUtils.getName(fullPath);
	  String filePath = FilenameUtils.getFullPath(fullPath);
	  // Create the primary document to add
	  //PrimaryDocument primaryDocToAdd = new PrimaryDocument(fileName, ScriptUtils.getConstant("BORDEREAU_NAME_ATTACHMENT"), ScriptUtils.getConstant("BORDEREAU_TYPE_ATTACHMENT"));
	  PrimaryDocument primaryDocToAdd = new PrimaryDocument(fileName, fileName, attachmentType);
	  try 
	  {
		// Add the primary Document
		docOnpPj.getAirsDocument().getInnerDocument().addOrUpdatePrimaryDocument(primaryDocToAdd, filePath);
	  }
	  catch(Exception e) 
	  {
		//scriptLogger.error(e.getLocalizedMessage(), e);
		throw new RuntimeException(e);
	  }
	}

