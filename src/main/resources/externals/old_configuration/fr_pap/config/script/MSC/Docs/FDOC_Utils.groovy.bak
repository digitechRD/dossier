	}
	
  /**
   * Ajoute une entree dans l'historique d'un document
   * @param document : Le document.
   * @param userContext : Le contexte de l'utilisateur courant.
   * @param typeEvent : type de l'évenement AdvancedAuditType.
   * @param libelle : Libellé à ajouter.
   */
	private static void addHisto(IDocument document, UserCoreContext userContext, String typeEvent, String libelle) {
		// Si le document n'est pas verrouille
		if (document.getLockType() != com.digitech.dossier.common.model.backend.Constants.DOC_LOCKED_BYOTHER) {
			if (libelle != null) {
				getAuditMgr().addDocumentEvent(userContext, document, typeEvent, libelle);
			}
		}
	}

  /**
   * Envoi de mail
   * @param document : Le document
   * @param userContext : Le contexte de l'utilisateur courant
   * @user : l'utilisateur connecté
   * @emailTo : la valeur De
   * @emailFrom : la valeur Pour
   * @emailCc : la valeur Copie à
   * @emailBcc : la valeur Copie cachée à
   * @emailSubject : la valeur du sujet
   * @emailContent : la valeur du contenu
   * @emailSendLinkToDocument : true si on veut ajouter un lien sur le document dans le contenu du mail
   * @emailAttachments : liste des pièces jointes
   */
	public static boolean sendMailAvecLien(IDocument document, UserContext userContext,
		String emailTo, String emailFrom, String emailCc, String emailBcc, String emailSubject,
		String emailContent, String emailSendLinkToDocument, List<IAttachment> emailAttachments) {

		String methodName = "sendMailAvecLien";

		log.debug(methodName + " : envoi mail a " + emailTo);

		Dictionary<String, Object> fields = new Hashtable<>();
		if (StringUtils.isNotBlank(emailFrom)) {
			fields.put(IMail.FROM, emailFrom);
		}
		if (StringUtils.isNotBlank(emailTo)) {
			fields.put(IMail.TO, emailTo);
		}
		if (StringUtils.isNotBlank(emailCc)) {
			fields.put(IMail.CC, emailCc);
		}
		if (StringUtils.isNotBlank(emailBcc)) {
			fields.put(IMail.BCC, emailBcc);
		}
		if (StringUtils.isNotBlank(emailSubject)) {
			fields.put(IMail.SUBJECT, emailSubject);
		}

		// Ajout du lien cliquable si besoin au sein du contenu du mail
		if (emailSendLinkToDocument.equals("true")) {
			String url = DossierCoreContext.getParamsInfos().getWebAppURL() + "/faces/redirect.jsp?outcome=gotoDocumentUnitaire&docId=" + document.getAirsRefId();
			String docLink = "Pour accéder directement au document en GED : " + url;

			if (StringUtils.isNotBlank(emailContent))
				emailContent = emailContent + "\n\n";

			emailContent = emailContent + docLink;
		}
		if (StringUtils.isNotBlank(emailContent))
			fields.put(IMail.CONTENT, emailContent);

		IMail emailService = (IMail) ServiceManager.getInstance().getService(Constants.SERVICE_MAIL_MGR);

		try {
			emailService.sendMail(userContext, document, emailAttachments, fields, null, null);
			return true;
		}
		catch (Exception e) {
			log.error(methodName + " : " + e.getMessage());
		}

		return false;
	}
	/**
	* Permet de mettre à jour le champ system qui contient la pj à signer
	* @param userContext : Le contexte de l'utilisateur courant
	* @param document le document AIRS
	*/
	public static boolean setAttachPjIdToSign(UserContext userContext, IDocument document)
	{
		String methodName = "setAttachPjIdToSign";
		boolean ret = true;

		try {
			Integer pjIdEditable = 0;
			Integer pjIdAnnexe = 0;

			// On recupère la liste des pièces jointes et on cherche celle qui est du type editable. Au pire, on prend une annexe
			List<IAttachment> pJList = document.getAttachments(userContext);

			log.debug(methodName + " : Nb de PJ : " + pJList.size());

			for (IAttachment pj : pJList) {
				log.debug(methodName + " : Parcours des PJs, PJ de type " + pj.getType());

				if(pj.getType().equals(getConstant("ATTACHMENT_TYPE_EDIT") && pj.getFileName().endsWith(".odt"))) {
					log.debug(methodName + " : pj editable et odt, on prend");
					pjIdEditable = pj.getId();
					break;
				}

				if(!pj.getType().equals(getConstant("ATTACHMENT_TYPE_DEFINITIVE"))) {
					log.debug(methodName + " : pj autre, on prend au cas ou");
					pjIdAnnexe = pj.getId();
					continue;
				}
			} // for pJList

			String fieldCode = getConstant("FIELD_CODE_ATTACHMENTID_TOSIGN");

			if (pjIdEditable > 0) {
				log.debug(methodName + " : Set Pj editable à signer : " + pjIdEditable);
				FieldUtils.setValue(document, fieldCode, pjIdEditable);
			}
			else if (pjIdAnnexe > 0) {
				log.debug(methodName + " : Set Pj annexe à signer : " + pjIdAnnexe);
				FieldUtils.setValue(document, fieldCode, pjIdAnnexe);
			}
			else {
				log.debug(methodName + " : Pas de pj à signer, bizarre");
			}
		}
		catch(Exception e) {
			log.error(e.getMessage());
			ret = false;
		}
		
		return ret;
	} // setAttachPjIdToSign

	/**
	* Permet de mettre à jour le champ system qui contient le signataire
	* @param userContext : Le contexte de l'utilisateur courant
	* @param document le document AIRS
	*/
	public static boolean setSignataire(UserContext userContext, IDocument document)
	{
		String methodName = "setSignataire";
		boolean ret = true;
		
		try {

			String fieldCodeDest = getConstant("FIELD_CODE_U_SIGNATORY");
			Integer signataireValue = FieldUtils.getValue(document, getConstant("FIELD_CODE_SIGNER_USER"));
			
			FieldUtils.setValue(document, getConstant("FIELD_CODE_U_SIGNATORY"), signataireValue);

			log.debug(methodName + " : maj signataire : " + signataireValue);
		}
		catch(Exception e) {
			log.error(e.getMessage());
			ret = false;
		}
		
		return ret;
	} // setSignataire

	/**
	* Permet de savoir si le document a été signé électroniquement
	* @param userContext : Le contexte de l'utilisateur courant
	* @param document le document AIRS
	*/
	public static boolean isDocumentDigitallySigned(UserContext userContext, IDocument document)
	{
		String methodName = "isDocumentDigitallySigned";
		boolean ret = false;
		
		try {
			List<Integer> pjDigitalisedSigned = FieldUtils.getValues(document, getConstant("FIELD_CODE_ATTACHMENTIDS_SIGNED"));
			if ((pjDigitalisedSigned != null) && (!pjDigitalisedSigned.isEmpty())) {

				ret = true;
			}
		}
		catch(Exception e) {
			log.error(e.getMessage());
			ret = false;
		}

		if (ret)
			log.debug(methodName + " : Signe electroniquement");
		else
			log.debug(methodName + " : Pas signe electroniquement");

		return ret;
	} // isDocumentDigitallySigned

	/**
	* Permet de modifier les propriétés des pjs d'un document après signature
	*   Un Pdf avec un type Editable -> type Définitif
	* @param userContext : Le contexte de l'utilisateur courant
	* @param document le document AIRS
	*/
	public static boolean setAttachmentsNormalizeAfterSignature(UserContext userContext, IDocument document)
	{
		String methodName = "setAttachmentsNormalizeAfterSignature";
		boolean ret = true;

		try {

			List<IAttachment> pJList = document.getAttachments(userContext);
			for (IAttachment pj : pJList) {

				if(pj.getType().equals(getConstant("ATTACHMENT_TYPE_EDIT")) && pj.getFileName().endsWith(".pdf")) {

					log.debug(methodName + " : On passe en version definitive (" + pj.getId() + ")");
					pj.setMode(com.digitech.dossier.common.model.backend.airs.IDocument.MODE_EDIT);
					pj.setType(getConstant("ATTACHMENT_TYPE_DEFINITIVE"));
					getDocumentMgr().updateDocumentAttachments(userContext, document);
					break;
				}
			} // for pJList
		}
		catch(Exception e) {
			log.error(e.getMessage());
			ret = false;
		}
		
		return ret;
	} // setAttachmentsNormalizeAfterSignature

