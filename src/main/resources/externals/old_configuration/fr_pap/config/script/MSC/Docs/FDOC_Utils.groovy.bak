	/**
	* Envoi un mail à  un utilisateur
	* @userContext      :
	* @theDocument      :
	* @user             :
	* @mailSubjectKey   :
	* @templateFileName :
	*/
    public static void sendNotification(UserContext userContext, IDocument theDocument, User user, String mailSubjectKey, String templateFileName, String state) 
	{
		String methodName = "sendNotification";
        File templateFile = new File(CourrierUtils.getCourrierTemplateFolderPath(), templateFileName);
        Map<String, Object> customPropertyMap = new HashMap<String, Object>();
        customPropertyMap.put("state", state);
		
        if (user != null) 
		{
            String authLogin = getConstant("MAIL_NOTIFICATION_AUTH_DEFAULT_LOGIN", null);
            String authPassword = getConstant("MAIL_NOTIFICATION_AUTH_DEFAULT_PASSWORD", null);

            if (user.getEmail() != null && user.getEmail().length() > 5 && !user.getId().equals(userContext.getUserId())) 
			{
                // Send the mail to the user if he has a mail and is not also the sender
                ApplicationUtils.sendMail(userContext, Arrays.asList(theDocument), templateFile, new ReportPerson(userContext, user), mailSubjectKey, customPropertyMap, Boolean.TRUE, authLogin, authPassword);
            }
        }
    }
	
	
	public static List<Integer> airsSearch(String airsRequest, String contentType, UserContext userContext)
	{
		List<Domain> contentTypes = new ArrayList<Domain>();	
		contentTypes.add(getServerMgr().getDomain(userContext.getJeton(), contentType));	
		Search searchModel = new Search(userContext.getJeton(), new Request(airsRequest), contentTypes);		
