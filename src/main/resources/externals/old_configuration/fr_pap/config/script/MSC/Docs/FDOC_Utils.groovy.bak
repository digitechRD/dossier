	private final static Logger log = LoggerFactory.getLogger("com.digitech.dossier.script.FDOC_Utils");
	private static File constantsFile = null;
	private static Properties properties = new Properties();
	
	static 
	{
		constantsFile = new File(DossierCoreContext.getApplicationPath() + File.separator + ScriptMgr.SCRIPT_RELATIVE_PATH + File.separator + "FDOC" + File.separator + "global" + File.separator + "Constantes.properties");
		constantsFile.withInputStream 
		{ 
			stream->properties.load(stream)
		}
	}

	public static String getConstant(String code) 
	{
		if (!properties.containsKey(code)) 
		{
			throw new ScriptException("Client '" + code + "' non trouvee au sein du fichier " + constantsFile);
		}
		return properties.getProperty(code);
	}

	public static String getConstant(String code, String defaultValue) 
	{
		if (!properties.containsKey(code)) 
		{
			return defaultValue;
		}
		return properties.getProperty(code);
	}
	
	/**
	* Verifie si le document possède un ou plusieurs validateur(s).
	* @param document le document AIRS
	* @return true si le champ "" du document possède une ou plusieurs valeurs
	*/
	public static boolean hasValidator(IDocument document) 
	{
		try 
		{
			List<Integer> docValidators = FieldUtils.getValues(document, getConstant("FIELD_CODE_VALIDATOR_LIST"));
			if ((docValidators != null) && (!docValidators.isEmpty())) 
			{
				return true;
			}
		}
		catch (Exception e) 
		{
			log.error("hasValidator : "+e.getMessage());
		}
		return false;
	}
	
	/**
	* Verifie si le document possède un signataire.
	* @param document le document AIRS
	* @return true si le champ "" du document possède une valeur
	*/
    public static boolean hasSigner(IDocument document) 
	{
        try 
		{
			Integer docSigner = FieldUtils.getValue(document, getConstant("FIELD_CODE_SIGNER_USER"));
            if ((docSigner != null) && docSigner != 0) 
			{
                return true;
            }
        }
        catch (Exception e) 
		{
			log.error("hasSigner : "+e.getMessage());
        }
        return false;
    }

	/**
	* Verifie si le document possède un des circuit de validation present dans la liste circuits.
	* @param document le document AIRS
	* @param etats les circuits possibles
	* @return true si le champ "FDOC_CIRCUIT_VAL" du document possède une des valeurs presente au sein de la liste circuits
	*/
    public static boolean hasCircuit(IDocument document, List<String> circuits) 
	{
        String fieldCodeDocumentCircuit = getConstant("FIELD_CODE_VALIDATION_CIRCUIT");
        Integer circuitId = (Integer) FieldUtils.getValue(document, fieldCodeDocumentCircuit);
        if (circuitId != null) 
		{
            Term term = ((IAuthorityList) getAuthorityListService()).getTerm(circuitId);
            if (term == null) 
			{
                throw new IllegalStateException("Aucun terme avec l'ID '" + circuitId + "' trouve pour la liste d'autorite " + fieldCodeDocumentCircuit);
            }
            return circuits.contains(term.getCode());
        }
        return false;
    }


	/**
	* Verifie si le document est dans un des etats present dans la liste states.
	* @param document le document AIRS
	* @param etats les etats possibles
	* @return true si le champ "FDOC_ETAT_WKF" du document possède une des valeurs presente au sein de la liste etats
	*/
    public static boolean hasState(IDocument document, List<String> states) 
	{
        String fieldCodeDocumentState = getConstant("FIELD_CODE_STATUS");
        Integer stateId = (Integer) FieldUtils.getValue(document, fieldCodeDocumentState);
        if (stateId != null) 
		{
            Term term = ((IAuthorityList) getAuthorityListService()).getTerm(stateId);
            if (term == null) 
			{
                throw new IllegalStateException("Aucun terme avec l'ID '" + stateId + "' trouve pour la liste d'autorite " + fieldCodeDocumentState);
            }
            return states.contains(term.getCode());
        }
        return false;
    }

	/**
	* Permet de changer l'etat d'un document
	* @param document le document AIRS
	* @param le code de l'etat souhaite (se base sur la liste d'autorite FDOC_ETAT_WKF)
	*/
    public static boolean changeState(UserContext userContext, IDocument document, String state) 
	{	
		boolean ret = true;
		
		try
		{
			//Mise à jour du document avec le nouveau statut
			String fieldCode = getConstant("FIELD_CODE_STATUS");
			FieldUtils.setValue(document, fieldCode, getTermID(fieldCode, state))
			
			//Ajout d'une ligne dans l'historique
			addHistoForWorkflow(document, userContext, "Changement d'etat : "+state);
		}
		catch(Exception e)
		{
			log.error(e.getMessage());
			ret = false;
		}
		
		return ret;
	}
	
	/**
	* Verifie si l'utilisateur connecte est l'utilisateur traitant (base sur le champ FDOC_USER_TRAIT).
	* @param userContext le contexte de l'utilisateur connecte
	* @param document le document AIRS
	* @return true si l'utilisateur connecte est l'utilisateur traitant du document
	*/
    public static boolean isOwnerUser(UserContext userContext, IDocument document) 
	{
       Integer docUserOwner = Integer.valueOf( FieldUtils.getValue(document, getConstant("FIELD_CODE_OWNER_USER")));
       return (docUserOwner != null && docUserOwner.equals(userContext.getUser().getId()));
    }
	
	/**
	* Verifie si l'utilisateur connecte est le valideur courant du document (base sur le champ FDOC_CUR_VALIDEUR).
	* @param userContext le contexte de l'utilisateur connecte
	* @param document le document AIRS
	* @return true si l'utilisateur connecte est le valideur courant du document
	*/
    public static boolean isValidatorUser(UserContext userContext, IDocument document) 
	{
		Integer docValidator;
		Object validatorObject = FieldUtils.getValue(document, getConstant("FIELD_CODE_VALIDATOR_USER"));
		
		if(validatorObject!=null)
		{
			docValidator = Integer.valueOf(validatorObject);
		}

		//try {
        //   throw new Exception("Invalid U_GESTS value!")
        //}
        //catch(Exception e) {
        //       log.warn("Field '{}' starts with a ; ('{}')", "FIELD_GESTIONNAIRES_CODE", "value");
        //       log.error(e.getMessage(), e)
        //}
		
        return docValidator != null && docValidator.equals(userContext.getUser().getId());
    }
	
	/**
	* Verifie si le valideur courant est le dernier valideur (base sur les 2 champs FDOC_CUR_VALIDEUR & FDOC_VALIDEURS).
	* @param document le document AIRS
	* @return true si le valideur courant du document est le dernier
	*/
    public static boolean isLastValidator(IDocument document) 
	{
	
        Integer docValidator = null;
        List<Integer> docValidators = null;
        try 
		{
            docValidator = FieldUtils.getValue(document, getConstant("FIELD_CODE_VALIDATOR_USER"));
            docValidators = FieldUtils.getValues(document, getConstant("FIELD_CODE_VALIDATOR_LIST"));
        }
        catch (IllegalStateException ise) 
		{
			throw new ScriptException(ise.getMessage());
        }

        return docValidators == null || docValidators.size() == 0 || docValidators.get(docValidators.size() - 1).equals(docValidator);
    }

	/**
	* Retourne l'id du valideur suivant (base sur les 2 champs FDOC_CUR_VALIDEUR & FDOC_VALIDEURS).
	* @param document le document AIRS
	* @return l'id du valideur suivant, null sinon
	*/
    public static Integer getNextValidator(IDocument document) 
	{
		try 
		{
            Integer currentValidator = FieldUtils.getValue(document, getConstant("FIELD_CODE_VALIDATOR_USER"));
            List<Integer> docValidators = FieldUtils.getValues(document, getConstant("FIELD_CODE_VALIDATOR_LIST"));
            if (docValidators != null) 
			{
                int i = 0;
                for (Integer valid : docValidators) 
				{
                    if (valid.equals(currentValidator)) 
					{
                        if (docValidators.size() > (i + 1)) 
						{
                            return docValidators.get(i + 1);
                        }
                    }
                    i++;
                }
            }
        }
        catch (Exception e) 
		{
			throw new ScriptException(e.getMessage());
        }
        return null;
    }

