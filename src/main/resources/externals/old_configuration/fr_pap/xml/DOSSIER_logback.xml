<configuration debug="true" scan="true" scanPeriod="1 minute">
  <property resource="logback.properties"/>
  <!-- This file can be temporary created when changing log level from preferences' page -->
  <property file="${dossier_app}xml/logback-overridden.properties"/>
  <!-- the next line is just here to make reloadable workedn when modifying logback.properties -->
  <include optional="true" file="${dossier_app}WEB-INF/classes/logback.properties"/>
  <include optional="true" file="${dossier_app}xml/externalLogback.xml"/>

  <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
    <resetJUL>true</resetJUL>
  </contextListener>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>${log_level_stdout:-OFF}</level>
    </filter>
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <Pattern>%d{HH:mm:ss.SSS} %-5level [%thread][%file:%line] %msg%n%rEx</Pattern>
    </encoder>
    <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
      <evaluator name="loggingTaskEval">
        <expression>
          return (logger.contains("groovyLog") || logger.contains("scriptLog"));
        </expression>
      </evaluator>
      <OnMatch>DENY</OnMatch>
      <OnMismatch>ACCEPT</OnMismatch>
    </filter>
  </appender>

  <appender name="FILE_ROLL" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${log_path}/${project_filename:-dossierweb}.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <FileNamePattern>${log_path}/${project_filename:-dossierweb}_%d{yyyy-MM-dd}_%i.log.zip</FileNamePattern>
      <!-- each file should be at most 10MB, keep 10 periods -->
      <maxFileSize>${log_max_rolling_size:-50MB}</maxFileSize>
      <maxHistory>${log_max_rolling_idx:-20}</maxHistory>
      <totalSizeCap>${log_total_size_cap:-4}GB</totalSizeCap>
    </rollingPolicy>

    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <Pattern>%d{HH:mm:ss.SSS} %-5level [%thread][%X{username}][%logger{24}:%line] %msg%n%rEx</Pattern>
    </encoder>

    <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
      <evaluator name="loggingTaskEval">
        <expression>
          return logger.contains("scriptLog");
        </expression>
      </evaluator>
      <OnMatch>DENY</OnMatch>
      <OnMismatch>ACCEPT</OnMismatch>
    </filter>
  </appender>

  <appender name="FILE_AIRS" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${log_path}/${project_filename:-dossierweb-airs}.log</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <FileNamePattern>${log_path}/${project_filename:-dossierweb-airs}_%d{yyyy-MM-dd}_%i.log.zip</FileNamePattern>
        <!-- each file should be at most 10MB, keep 10 periods -->
        <maxFileSize>${log_max_rolling_size:-50MB}</maxFileSize>
        <maxHistory>${log_max_rolling_idx:-20}</maxHistory>
        <totalSizeCap>${log_total_size_cap:-4}GB</totalSizeCap>
      </rollingPolicy>

      <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
        <Pattern>%d{HH:mm:ss.SSS} %-5level [%thread][%X{username}][%logger{24}:%line] %msg%n%rEx</Pattern>
      </encoder>

      <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
        <evaluator name="loggingTaskEval">
          <expression>
            return logger.contains("scriptLog");
          </expression>
        </evaluator>
        <OnMatch>DENY</OnMatch>
        <OnMismatch>ACCEPT</OnMismatch>
      </filter>
    </appender>

  <appender name="FILE_CMIS" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${log_path}/${project_filename:-dossierweb}_cmis.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <FileNamePattern>${log_path}/${project_filename:-dossierweb}_cmis_%i.log</FileNamePattern>
      <MinIndex>1</MinIndex>
      <MaxIndex>20</MaxIndex>
    </rollingPolicy>

    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <MaxFileSize>50MB</MaxFileSize>
    </triggeringPolicy>

    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <Pattern>%d{HH:mm:ss.SSS} %-5level [%thread][%logger:%line] %msg%n%rEx</Pattern>
    </encoder>
  </appender>

  <appender name="FILE_SCRIPT" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${log_path}/${project_filename:-dossierweb}_scripts.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <FileNamePattern>${log_path}/${project_filename:-dossierweb}_scripts_%i.log</FileNamePattern>
      <MinIndex>1</MinIndex>
      <MaxIndex>10</MaxIndex>
    </rollingPolicy>

    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <MaxFileSize>10MB</MaxFileSize>
    </triggeringPolicy>

    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <Pattern>%d{HH:mm:ss.SSS} %-5level [%thread][%logger{0}:%line] %msg%n%rEx</Pattern>
    </encoder>

    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>${log_level_script:-WARN}</level>
    </filter>

    <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
      <evaluator name="loggingTaskEval">
        <expression>
          return logger.contains("scriptLog");
        </expression>
      </evaluator>
      <OnMatch>ACCEPT</OnMatch>
      <OnMismatch>DENY</OnMismatch>
    </filter>
  </appender>

  <appender name="SCHEDULER_SCRIPT" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${log_path}/${project_filename:-dossierweb}_scheduler.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <FileNamePattern>${log_path}/${project_filename:-dossierweb}_scheduler_%i.log</FileNamePattern>
      <MinIndex>1</MinIndex>
      <MaxIndex>10</MaxIndex>
    </rollingPolicy>

    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <MaxFileSize>50MB</MaxFileSize>
    </triggeringPolicy>

    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <Pattern>%d{HH:mm:ss.SSS} %-5level [%thread][%logger{0}:%line] %msg%n%rEx</Pattern>
    </encoder>

    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>${log_scheduler_level:-WARN}</level>
    </filter>
  </appender>

  <appender name="POPULATION" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${log_path}/${project_filename:-dossierweb}_pop.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <FileNamePattern>${log_path}/${project_filename:-dossierweb}_pop_%i.log</FileNamePattern>
      <MinIndex>1</MinIndex>
      <MaxIndex>10</MaxIndex>
    </rollingPolicy>

    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <MaxFileSize>50MB</MaxFileSize>
    </triggeringPolicy>

    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <Pattern>%d{HH:mm:ss.SSS} %-5level [%thread][%logger{0}:%line] %msg%n%rEx</Pattern>
    </encoder>

    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>${log_level_pop:-WARN}</level>
    </filter>
  </appender>

